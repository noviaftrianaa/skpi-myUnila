# ===========================================
# Dashboard Service Configuration
# ===========================================

APP_NAME="Dashboard Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8082
APP_APLIKASI_ID=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ===========================================
# Database Configuration (SQL Server)
# ===========================================
DB_CONNECTION=sqlsrv
DB_HOST=
DB_PORT=1433
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true

# ===========================================
# Redis Configuration
# ===========================================
REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

# Cache & Session
CACHE_DRIVER=redis
CACHE_PREFIX=dashboard_
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# ===========================================
# Meilisearch Configuration
# ===========================================
MEILISEARCH_HOST=
MEILISEARCH_KEY=

# ===========================================
# Logging
# ===========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ===========================================
# Mail Configuration
# ===========================================
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ===========================================
# File Storage
# ===========================================
FILESYSTEM_DISK=local

# ===========================================
# Development Helpers
# ===========================================
AUTO_MIGRATE=false
WAIT_FOR_DB=true
