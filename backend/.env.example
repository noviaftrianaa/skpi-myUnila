# =============================================
# My Unila Backend - Environment Configuration
# =============================================
# Copy this file to .env and fill in your values
# For shared configuration across services, use .env.shared

# =============================================
# Application Environment
# =============================================
APP_ENV=local
APP_DEBUG=true

# =============================================
# SQL Server Database Configuration
# REQUIRED: Must be filled for auth-service
# =============================================
DB_SQLSRV_HOST=host.docker.internal
DB_SQLSRV_PORT=1433
DB_AUTH_DATABASE=auth_db
DB_SQLSRV_USERNAME=sa
DB_SQLSRV_PASSWORD=YourStrong@Passw0rd

# =============================================
# Laravel App Keys (Generate per service)
# REQUIRED: Must be generated and filled
# =============================================
# Generate: php artisan key:generate
AUTH_APP_KEY=base64:your_generated_key_here_replace_this

# =============================================
# JWT Configuration
# REQUIRED: Generate strong secret for JWT
# =============================================
# Generate: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_replace_this_with_strong_secret
JWT_TTL=60
JWT_REFRESH_TTL=10080

# =============================================
# SSO Unila Configuration
# OPTIONAL: Leave empty if not using SSO
# =============================================
SSO_UNILA_BASE_URL=https://akses.unila.ac.id
SSO_UNILA_APP_KEY=
SSO_UNILA_JWT_SECRET=
SSO_UNILA_CALLBACK_URL=http://localhost:8080/auth-service/api/v1/auth/sso/callback

# =============================================
# Application ID (for logging)
# OPTIONAL: Default value provided
# =============================================
APP_APLIKASI_ID=00000000-0000-0000-0000-000000000001

# =============================================
# Sister API Kemdikbud Configuration
# REQUIRED for sister-service: Get token from Sister Kemdikbud
# =============================================
SISTER_API_TOKEN=your_sister_api_jwt_token_here

# =============================================
# QUICK SETUP GUIDE
# =============================================
# 1. Copy this file: cp .env.example .env
# 2. Generate Laravel key:
#    cd auth-service
#    php artisan key:generate
#    Copy generated key to AUTH_APP_KEY
#
# 3. Generate JWT secret:
#    openssl rand -base64 32
#    Copy output to JWT_SECRET
#
# 4. Update SQL Server credentials:
#    - DB_SQLSRV_HOST (use host.docker.internal for Docker)
#    - DB_SQLSRV_USERNAME
#    - DB_SQLSRV_PASSWORD
#
# 5. Start Docker:
#    docker-compose up -d
#
# 6. Run SQL setup:
#    Execute: auth-service/database/sqlserver/create_mfa_tables.sql
#
# 7. Test with Postman:
#    Import: auth-service/postman/Auth-Service.postman_collection.json
