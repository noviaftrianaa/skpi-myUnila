# ===========================================
# MyUnila API Service Configuration
# ===========================================

APP_NAME="MyUnila API Service"
APP_PORT=:8085
APP_ENV=development
APP_URL=http://localhost:8085

# ===========================================
# Database Configuration (SQL Server)
# ===========================================
DB_DRIVER=sqlserver
DB_HOST=localhost
DB_PORT=1433
DB_DATABASE=pdut
DB_USERNAME=sa
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=your-secret-key-here
JWT_ALGO=HS256
JWT_ACCESS_TOKEN_TTL=60
JWT_ISSUER=myunila-api
