# Application
APP_NAME=Api Service
APP_PORT=:8087
APP_ENV=development

# SQL Server Database
DB_DRIVER=sqlserver
DB_HOST=
DB_PORT=1433
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true

# Connection Pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=
JWT_ALGO=HS256

# Logging
LOG_LEVEL=info
