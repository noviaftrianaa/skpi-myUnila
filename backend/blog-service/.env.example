# =============================================================================
# blog-service environment template
# Copy ke .env (gitignored) untuk local dev.
# =============================================================================

APP_NAME=blog-service
APP_PORT=8091
APP_ENV=development

# PostgreSQL (dedicated DB blog_unila)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blog_unila
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# CORS (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:9800

# JWT — MUST match auth-service JWT_SECRET di backend/auth-service/.env
JWT_SECRET=changeme-must-match-auth-service
JWT_ALGO=HS256

# =============================================================================
# MinIO (object storage for blog-media bucket — Phase AJ/AK)
# Local dev: spun up by docker-compose.blog.yml as blog-minio.
# Production: minio.unila.ac.id with per-bucket credentials.
# =============================================================================
MINIO_ENDPOINT=blog-minio:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=blog-media
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9100

# =============================================================================
# Meilisearch (search index — Phase AP)
# Shared with public-service; we keep our own index under MEILISEARCH_INDEX.
# =============================================================================
MEILISEARCH_URL=http://myunila-meilisearch:7700
MEILISEARCH_API_KEY=changeme
MEILISEARCH_INDEX=blog_post

# =============================================================================
# Email / SMTP (Phase AY)
# Mail config is dynamic via admin UI (blog.mail_config table) — admin sets the
# active SMTP profile via /dashboard/blog-platform/admin/mail-config.
# Mailpit container provided in docker-compose.blog.yml for local SMTP testing
# (web UI at http://localhost:8125). No env vars consumed at runtime.
# =============================================================================
