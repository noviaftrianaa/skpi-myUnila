# Application
APP_NAME=MyUnila Service
APP_PORT=:8086
APP_ENV=development

# Database (SQL Server)
DB_DRIVER=sqlserver
DB_HOST=localhost
DB_PORT=1433
DB_DATABASE=pdut
DB_USERNAME=sa
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# SIKEP API
SIKEP_API_BASE_URL=https://sikep.unila.ac.id/2022/api/v1
SIKEP_API_USERNAME=
SIKEP_API_PASSWORD=

# Radius API (SSO Unila)
# Used for syncing radius/SSO user data from akses.unila.ac.id
RADIUS_API_BASE_URL=https://akses.unila.ac.id/api/live/v1
RADIUS_API_APP_KEY=
RADIUS_API_USERNAME=

# API Config Encryption Key (32 characters)
# Used for encrypting sensitive API credentials stored in database
API_CONFIG_ENCRYPTION_KEY=12345678901234567890123456789012
