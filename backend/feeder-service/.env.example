# Application
APP_NAME=Feeder Service
APP_PORT=:8084
APP_ENV=development

# Neo Feeder PDDIKTI API (Fallback - Priority: Database > Environment)
FEEDER_API_BASE_URL=https://dapelmikpdpt.unila.ac.id/New/ws/Api.php
FEEDER_API_USERNAME=
FEEDER_API_PASSWORD=

# SQL Server Database
DB_DRIVER=sqlserver
DB_HOST=
DB_PORT=1433
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true

# Connection Pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Logging
LOG_LEVEL=info

# API Configuration Encryption
API_CONFIG_ENCRYPTION_KEY=
