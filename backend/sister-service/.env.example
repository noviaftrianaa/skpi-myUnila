# Application
APP_NAME=Sister Service
APP_PORT=:8083
APP_ENV=development

# JWT Configuration (shared with auth-service)
JWT_SECRET=
JWT_ALGO=HS256

# API Config Encryption Key (MUST be exactly 32 characters for AES-256)
# Generate with: openssl rand -base64 32 | head -c 32
API_CONFIG_ENCRYPTION_KEY=

# Sister API Kemdikbud (fallback when database config not set)
SISTER_API_BASE_URL=https://sister-api.kemdikbud.go.id/ws.php
SISTER_API_IDPENGGUNA=
SISTER_API_USERNAME=
SISTER_API_PASSWORD=

# Feeder PDDIKTI API (fallback when database config not set)
FEEDER_API_USERNAME=
FEEDER_API_PASSWORD=

# SQL Server Database
DB_DRIVER=sqlserver
DB_HOST=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=

# Connection Pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Logging
LOG_LEVEL=info
