# Application
APP_NAME=Sister Service
APP_PORT=:8083
APP_ENV=development

# JWT Configuration (shared with auth-service)
JWT_SECRET=your_jwt_secret_here_must_match_auth_service
JWT_ALGO=HS256

# API Config Encryption Key (MUST be exactly 32 characters for AES-256)
# Generate with: openssl rand -base64 32 | head -c 32
API_CONFIG_ENCRYPTION_KEY=your_32_character_encryption_key

# Sister API Kemdikbud (fallback when database config not set)
SISTER_API_BASE_URL=https://sister-api.kemdikbud.go.id/ws.php
SISTER_API_IDPENGGUNA=125e6431-7727-402e-adb5-24d410af493c
SISTER_API_USERNAME=sister_unila
SISTER_API_PASSWORD=Unila2023!

# Feeder PDDIKTI API (fallback when database config not set)
FEEDER_API_USERNAME=feeder_username
FEEDER_API_PASSWORD=feeder_password

# SQL Server Database
DB_DRIVER=sqlserver
DB_HOST=myunila-sqlserver
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=your_password_here
DB_NAME=pddikti

# Connection Pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Logging
LOG_LEVEL=info
