# Application
APP_NAME=Sister Service
APP_PORT=:8083
APP_ENV=development

# Sister API Kemdikbud
SISTER_API_BASE_URL=https://sister-api.kemdiktisaintek.go.id/ws.php
SISTER_API_IDPENGGUNA=125e6431-7727-402e-adb5-24d410af493c
SISTER_API_USERNAME=
SISTER_API_PASSWORD=

# SQL Server Database
DB_DRIVER=sqlserver
DB_HOST=
DB_PORT=1433
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true

# Connection Pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Logging
LOG_LEVEL=info

# API Configuration Encryption
API_CONFIG_ENCRYPTION_KEY=

# MinIO Object Storage
MINIO_ENDPOINT=192.168.120.47:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=myunila-storage
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://192.168.120.47:9000
