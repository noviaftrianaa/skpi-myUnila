# Manajemen Konten Service — env template

# App
APP_NAME=Manajemen Konten Service
APP_PORT=:8090
APP_ENV=development

# Database (SQL Server pdut/pdut_staging)
DB_HOST=192.168.123.119
DB_PORT=1433
DB_DATABASE=pdut_staging
DB_USERNAME=
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MIN=60

# JWT (shared dengan auth-service)
JWT_SECRET=

# File storage (banner upload)
UPLOAD_DIR=/data/uploads
UPLOAD_BASE_URL=/man-konten/uploads

# Timezone
TZ=Asia/Jakarta
