# Application
APP_NAME=Monitoring Service
APP_PORT=:8089
APP_ENV=development

# SQL Server Database
DB_DRIVER=sqlserver
DB_HOST=
DB_PORT=1433
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Redis Cache (optional - service degrades gracefully without)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (shared secret with auth-service)
JWT_SECRET=
JWT_ALGO=HS256

# Blogger API (Google)
BLOGGER_API_KEY=

# Google Search Console Integration
GSC_SERVICE_ACCOUNT_JSON=/app/secrets/gsc-service-account.json
GSC_SITE_URL=sc-domain:unila.ac.id
GSC_AUTO_REMOVE_THRESHOLD=15
GSC_ENABLED=true

# Crawler Configuration
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_PAGES=500
CRAWLER_RATE_LIMIT_MS=1000
CRAWLER_CONCURRENT_SITES=3
CRAWLER_TIMEOUT_SEC=30
CRAWLER_USER_AGENT=MyUnila-WebMon/1.0 (+https://my.unila.ac.id/webmon)

# Deep Scan: Cloaking Detection (dual User-Agent scan)
CRAWLER_CLOAKING_ENABLED=true
CRAWLER_CLOAKING_THRESHOLD=0.7

# Deep Scan: AMP Cache Scan
CRAWLER_AMP_SCAN_ENABLED=true
