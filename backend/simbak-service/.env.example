# ===========================================
# SIMBAK Service Configuration
# ===========================================

APP_NAME="SIMBAK Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8091

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# ===========================================
# Database: PostgreSQL (simbak - PRIMARY)
# Transaksi data SIMBAK
# ===========================================
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=simbak
DB_USERNAME=
DB_PASSWORD=

# ===========================================
# Database: SQL Server (pdut - READ ONLY)
# Referensi: man_akses, siakadu, keuangan
# ===========================================
SQLSRV_HOST=192.168.123.119
SQLSRV_PORT=1433
SQLSRV_DATABASE=pdut_staging
SQLSRV_USERNAME=
SQLSRV_PASSWORD=
SQLSRV_TRUST_SERVER_CERTIFICATE=true

# ===========================================
# MinIO Configuration (VM7 - File Storage)
# ===========================================
MINIO_ENDPOINT=http://192.168.120.47:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=myunila-storage
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# ===========================================
# Redis Configuration
# ===========================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Cache & Session
CACHE_STORE=redis
CACHE_PREFIX=bak_
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# ===========================================
# JWT Configuration (Validation Only)
# Token diterbitkan oleh auth-service
# bak-service hanya validasi
# ===========================================
JWT_SECRET=
JWT_ALGO=HS256

# ===========================================
# Logging
# ===========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ===========================================
# File Storage
# ===========================================
# Local storage (default) — file di-mount via Docker volume
# Ganti ke "minio" kalau sudah ada MinIO server
FILESYSTEM_DISK=simbak
SIMBAK_STORAGE_PATH=/data/simbak-storage

# ===========================================
# Development Helpers
# ===========================================
AUTO_MIGRATE=false
WAIT_FOR_DB=true
BYPASS_PERMISSION_CHECK=false
