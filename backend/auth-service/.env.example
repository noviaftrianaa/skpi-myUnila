# ===========================================
# Auth Service Configuration
# ===========================================

APP_NAME="Auth Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8081
APP_APLIKASI_ID=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ===========================================
# Database Configuration (SQL Server)
# ===========================================
DB_CONNECTION=sqlsrv
DB_HOST=
DB_PORT=1433
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true

# ===========================================
# Redis Configuration (Managed by Docker)
# REDIS_HOST will be overridden by docker-compose
# ===========================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Cache & Session (Managed by docker-compose)
CACHE_STORE=redis
CACHE_PREFIX=auth_
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# ===========================================
# JWT Configuration (Auth Service Only)
# ===========================================
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=60
JWT_REFRESH_TOKEN_TTL=10080
JWT_MFA_TEMP_TTL=5
JWT_ALGO=HS256
JWT_BLACKLIST_ENABLED=true

# ===========================================
# SSO Unila Configuration (Auth Service Only)
# ===========================================
# OAuth2 SSO (Old method)
SSO_BASE_URL=https://sso.unila.ac.id
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI="${APP_URL}/auth/callback"
SSO_TOKEN_STORAGE=redis

# CAS SSO (New method - Direct SSO)
SSO_UNILA_BASE_URL=https://akses.unila.ac.id
SSO_UNILA_APP_KEY="${APP_KEY}"
SSO_UNILA_JWT_SECRET=
SSO_UNILA_CALLBACK_URL="${APP_URL}/api/v1/auth/sso/callback"
SSO_AUTO_CREATE_USER=true
SSO_CHECK_LEGACY_DB=true
SSO_LEGACY_DB_CONNECTION=sqlsrv
SSO_DEFAULT_ROLE=user

# ===========================================
# Google 2FA Configuration (Auth Service Only)
# ===========================================
GOOGLE_2FA_ENABLED=true
GOOGLE_2FA_LIFETIME=1

# ===========================================
# Logging
# ===========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ===========================================
# Mail Configuration
# ===========================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="noreply@unila.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# ===========================================
# File Storage
# ===========================================
FILESYSTEM_DISK=local

# ===========================================
# Development Helpers
# ===========================================
AUTO_MIGRATE=false
WAIT_FOR_DB=true

# Cookie settings for development (use secure=true in production)
SESSION_SECURE_COOKIE=false
