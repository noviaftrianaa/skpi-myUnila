{
	"info": {
		"_postman_id": "auth-service-2025",
		"name": "Auth Service - My Unila",
		"description": "Complete API collection for Auth Service with SSO integration",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{access_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8081/auth-service",
			"type": "string"
		},
		{
			"key": "access_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "refresh_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "temp_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "sso_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/health",
					"host": ["{{base_url}}"],
					"path": ["api", "health"]
				},
				"description": "Check if the service is running"
			},
			"response": []
		},
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login (Standard)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.data && response.data.tokens) {",
									"        pm.collectionVariables.set('access_token', response.data.tokens.access_token);",
									"        console.log('Access token saved');",
									"    }",
									"    if (response.temp_token) {",
									"        pm.collectionVariables.set('temp_token', response.temp_token);",
									"        console.log('Temp token saved for MFA');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"test_user\",\n  \"password\": \"password123\",\n  \"device_name\": \"postman\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Login with username and password"
					},
					"response": []
				},
				{
					"name": "Verify MFA",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.data && response.data.tokens) {",
									"        pm.collectionVariables.set('access_token', response.data.tokens.access_token);",
									"        console.log('Access token saved after MFA');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"temp_token\": \"{{temp_token}}\",\n  \"code\": \"123456\",\n  \"device_name\": \"postman\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/verify-mfa",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "verify-mfa"]
						},
						"description": "Verify MFA code after login"
					},
					"response": []
				},
				{
					"name": "Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.data && response.data.tokens) {",
									"        pm.collectionVariables.set('access_token', response.data.tokens.access_token);",
									"        console.log('Access token refreshed');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Cookie",
								"value": "refresh_token={{refresh_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/auth/refresh",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "refresh"]
						},
						"description": "Refresh access token using refresh token"
					},
					"response": []
				},
				{
					"name": "Get Current User",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/auth/me",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "me"]
						},
						"description": "Get current authenticated user"
					},
					"response": []
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/auth/logout",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "logout"]
						},
						"description": "Logout and revoke all tokens"
					},
					"response": []
				}
			]
		},
		{
			"name": "SSO Authentication",
			"item": [
				{
					"name": "Get SSO URL",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.data && response.data.sso_url) {",
									"        console.log('SSO URL: ' + response.data.sso_url);",
									"        console.log('Open this URL in browser to login');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/auth/sso/url?return_url=http://localhost:3000/dashboard",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "sso", "url"],
							"query": [
								{
									"key": "return_url",
									"value": "http://localhost:3000/dashboard",
									"description": "URL to return after login"
								}
							]
						},
						"description": "Get SSO login URL for API clients"
					},
					"response": []
				},
				{
					"name": "SSO Callback (API)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.data && response.data.tokens) {",
									"        pm.collectionVariables.set('access_token', response.data.tokens.access_token);",
									"        console.log('Access token saved from SSO');",
									"    }",
									"    if (response.temp_token) {",
									"        pm.collectionVariables.set('temp_token', response.temp_token);",
									"        console.log('MFA required - temp token saved');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"{{sso_token}}\",\n  \"device_name\": \"postman\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/sso/callback",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "sso", "callback"]
						},
						"description": "Exchange SSO token for JWT tokens"
					},
					"response": []
				},
				{
					"name": "Validate SSO Token",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"{{sso_token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/sso/validate",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "sso", "validate"]
						},
						"description": "Validate SSO token without creating session"
					},
					"response": []
				}
			]
		},
		{
			"name": "MFA Management",
			"item": [
				{
					"name": "Setup MFA",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/mfa/setup",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "mfa", "setup"]
						},
						"description": "Get QR code for MFA setup"
					},
					"response": []
				},
				{
					"name": "Enable MFA",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"code\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/mfa/enable",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "mfa", "enable"]
						},
						"description": "Enable MFA with verification code"
					},
					"response": []
				},
				{
					"name": "Disable MFA",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"code\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/mfa/disable",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "mfa", "disable"]
						},
						"description": "Disable MFA with verification code"
					},
					"response": []
				},
				{
					"name": "Generate Backup Codes",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/mfa/generate-backup-codes",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "mfa", "generate-backup-codes"]
						},
						"description": "Generate new backup codes for MFA"
					},
					"response": []
				},
				{
					"name": "Get MFA Status",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/mfa/status",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "mfa", "status"]
						},
						"description": "Check MFA status for current user"
					},
					"response": []
				}
			]
		}
	]
}
