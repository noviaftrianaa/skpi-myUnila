# ===========================================
# Public Service Configuration
# ===========================================

APP_NAME="Public Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8082
APP_APLIKASI_ID=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ===========================================
# Database Configuration (SQL Server)
# ===========================================
DB_CONNECTION=sqlsrv
DB_HOST=
DB_PORT=1433
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# Sister Database Connection (for SISTER data)
SISTER_DB_HOST=
SISTER_DB_PORT=1433
SISTER_DB_DATABASE=
SISTER_DB_USERNAME=
SISTER_DB_PASSWORD=

# Spordit Database (PostgreSQL read-only, untuk KTW reconcile)
SPORDIT_DB_HOST=192.168.123.39
SPORDIT_DB_PORT=5432
SPORDIT_DB_DATABASE=spordit
SPORDIT_DB_USERNAME=
SPORDIT_DB_PASSWORD=
SPORDIT_DB_CHARSET=utf8
SPORDIT_DB_SSLMODE=prefer

# ===========================================
# Redis Configuration (Managed by Docker)
# REDIS_HOST will be overridden by docker-compose
# ===========================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Cache & Session (Managed by docker-compose)
CACHE_DRIVER=redis
CACHE_PREFIX=dashboard_
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# ===========================================
# MeiliSearch Configuration
# ===========================================
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=
MEILISEARCH_KEY=
SCOUT_QUEUE=false

# ===========================================
# Dashboard Service Specific Configuration
# ===========================================
# No JWT or SSO needed - this is a public service

# Institution ID (Universitas Lampung)
UNILA_ID_SP=E2B705A7-173E-464A-9FAC-509128709515

# ===========================================
# Logging
# ===========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ===========================================
# Mail Configuration
# ===========================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="noreply@unila.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# ===========================================
# File Storage
# ===========================================
FILESYSTEM_DISK=local

# ===========================================
# MinIO Photo Storage
# ===========================================
MINIO_PUBLIC_URL=http://your-minio-host:9000
MINIO_BUCKET=myunila-storage

# ===========================================
# Development Helpers
# ===========================================
AUTO_MIGRATE=false
WAIT_FOR_DB=true
