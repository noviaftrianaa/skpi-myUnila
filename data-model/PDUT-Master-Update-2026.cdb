<a:Code>jns_matakuliah</a:Code>
<a:CreationDate>1634288259</a:CreationDate>
<a:Creator>ASUS</a:Creator>
<a:ModificationDate>1767446432</a:ModificationDate>
<a:Modifier>mizar</a:Modifier>
<a:Comment>Klasifikasi mata kuliah berdasarkan sifat pengambilan
Contoh nilai:
A = Wajib
B = Pilihan
C = Wajib peminatan
D = Pilihan peminatan
S = Tugas akhir/Skripsi/Thesis/Disertasi</a:Comment>
<a:DataType>A1</a:DataType>
<a:Length>1</a:Length>
</o:DataItem>
