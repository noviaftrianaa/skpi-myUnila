# ========================================
# MyUnila Local Development Environment
# ========================================
# PANDUAN SETUP:
#   1. Copy file ini ke .env:  cp .env.example .env
#   2. Isi 3 field WAJIB di bawah: DB_MSSQL_HOST, DB_MSSQL_USERNAME, DB_MSSQL_PASSWORD
#   3. Isi field lain yang kosong sesuai kebutuhan service Anda
#
# WAJIB diisi: DB_MSSQL_HOST, DB_MSSQL_USERNAME, DB_MSSQL_PASSWORD
# Minta credential ke admin jika belum punya.
# ========================================

# Local Configuration
VM_IP=localhost
ENVIRONMENT=local

# ========================================
# External Database (SQL Server)
# WAJIB: Isi dengan credential database tim
# ========================================
DB_MSSQL_HOST=
DB_MSSQL_PORT=1433
DB_MSSQL_DATABASE=pdut_dev
DB_MSSQL_USERNAME=
DB_MSSQL_PASSWORD=

# Feeder Service - Testing Database (override)
FEEDER_DB_DATABASE=pdut_dev

# ========================================
# Kong Database (PostgreSQL)
# HANYA diperlukan jika pakai Kong (deploy.sh)
# Jika pakai deploy-minimal.sh, SKIP bagian ini
# ========================================
KONG_PG_HOST=host.docker.internal
KONG_PG_PORT=5432
KONG_PG_DATABASE=kong_local
KONG_PG_USER=postgres
KONG_PG_PASSWORD=

# ========================================
# Redis Configuration (tidak perlu diubah)
# ========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================================
# MeiliSearch Configuration (tidak perlu diubah)
# Hanya diperlukan jika menjalankan public-service
# ========================================
MEILI_ENV=development
MEILI_MASTER_KEY=masterKey123456
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey123456

# ========================================
# Auth Service (Laravel)
# ========================================
AUTH_APP_NAME="MyUnila Auth Service - Local"
AUTH_APP_ENV=local
AUTH_APP_KEY=base64:Ni67WITr6h932ci73ilQeQkIEp6Qcu6LImnAAYyh4VI=
AUTH_APP_DEBUG=true
AUTH_APP_URL=http://localhost:8081

AUTH_DB_CONNECTION=sqlsrv
AUTH_DB_HOST=${DB_MSSQL_HOST}
AUTH_DB_PORT=${DB_MSSQL_PORT}
AUTH_DB_DATABASE=${DB_MSSQL_DATABASE}
AUTH_DB_USERNAME=${DB_MSSQL_USERNAME}
AUTH_DB_PASSWORD=${DB_MSSQL_PASSWORD}

AUTH_REDIS_HOST=${REDIS_HOST}
AUTH_REDIS_PORT=${REDIS_PORT}

# JWT Configuration
JWT_SECRET=local-dev-jwt-secret-key-change-in-production
JWT_ISSUER=http://localhost:8081
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800
JWT_ALGORITHM=HS256

# SSO Configuration (from auth-service/.env)
SSO_UNILA_BASE_URL=https://akses.unila.ac.id
SSO_UNILA_APP_KEY=
SSO_UNILA_JWT_SECRET=
SSO_UNILA_CALLBACK_URL=http://localhost:8081/api/v1/auth/sso/callback

# ========================================
# Public Service (Laravel)
# ========================================
PUBLIC_APP_NAME="MyUnila Public Service - Local"
PUBLIC_APP_ENV=local
PUBLIC_APP_KEY=base64:Ni67WITr6h932ci73ilQeQkIEp6Qcu6LImnAAYyh4VI=
PUBLIC_APP_DEBUG=true
PUBLIC_APP_URL=http://localhost:8082

PUBLIC_DB_CONNECTION=sqlsrv
PUBLIC_DB_HOST=${DB_MSSQL_HOST}
PUBLIC_DB_PORT=${DB_MSSQL_PORT}
PUBLIC_DB_DATABASE=${DB_MSSQL_DATABASE}
PUBLIC_DB_USERNAME=${DB_MSSQL_USERNAME}
PUBLIC_DB_PASSWORD=${DB_MSSQL_PASSWORD}

PUBLIC_REDIS_HOST=redis
PUBLIC_REDIS_PORT=6379

# Institution ID (Universitas Lampung)
UNILA_ID_SP=E2B705A7-173E-464A-9FAC-509128709515

# Sister DB connection (for bidang ilmu and other SISTER data)
SISTER_DB_HOST=${DB_MSSQL_HOST}
SISTER_DB_PORT=${DB_MSSQL_PORT}
SISTER_DB_DATABASE=${DB_MSSQL_DATABASE}
SISTER_DB_USERNAME=${DB_MSSQL_USERNAME}
SISTER_DB_PASSWORD=${DB_MSSQL_PASSWORD}

# SQL Server Connection Settings (for ODBC Driver 18)
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# Base DB settings (used by Laravel dashboard service)
DB_CONNECTION=sqlsrv
DB_HOST=${DB_MSSQL_HOST}
DB_PORT=${DB_MSSQL_PORT}
DB_DATABASE=${DB_MSSQL_DATABASE}
DB_USERNAME=${DB_MSSQL_USERNAME}
DB_PASSWORD=${DB_MSSQL_PASSWORD}

# ========================================
# Sister Service (Go + Fiber)
# ========================================
SISTER_APP_NAME="Sister Service - Local"
SISTER_APP_PORT=:8083
SISTER_APP_ENV=local

SISTER_DB_DRIVER=sqlserver
SISTER_DB_MAX_OPEN_CONNS=25
SISTER_DB_MAX_IDLE_CONNS=5
SISTER_DB_CONN_MAX_LIFETIME=5m

# SISTER API Kemdikbud (minta credential ke admin)
SISTER_API_BASE_URL=https://sister-api.kemdikbud.go.id/ws.php
SISTER_API_IDPENGGUNA=125e6431-7727-402e-adb5-24d410af493c
SISTER_API_USERNAME=
SISTER_API_PASSWORD=

SISTER_REDIS_HOST=${REDIS_HOST}
SISTER_REDIS_PORT=${REDIS_PORT}

API_CONFIG_ENCRYPTION_KEY=12345678901234567890123456789012

# Laravel APP_KEY for decrypting encrypted IDs from dashboard-service
LARAVEL_APP_KEY=Ni67WITr6h932ci73ilQeQkIEp6Qcu6LImnAAYyh4VI=

# ========================================
# Feeder Service (Go + Fiber)
# ========================================
FEEDER_APP_NAME="Feeder Service - Local"
FEEDER_APP_PORT=:8084
FEEDER_APP_ENV=local

FEEDER_DB_DRIVER=sqlserver
FEEDER_DB_HOST=${DB_MSSQL_HOST}
FEEDER_DB_PORT=${DB_MSSQL_PORT}
FEEDER_DB_USERNAME=${DB_MSSQL_USERNAME}
FEEDER_DB_PASSWORD=${DB_MSSQL_PASSWORD}
FEEDER_DB_TRUST_SERVER_CERTIFICATE=true
FEEDER_DB_MAX_OPEN_CONNS=25
FEEDER_DB_MAX_IDLE_CONNS=5
FEEDER_DB_CONN_MAX_LIFETIME=5m

# Neo Feeder PDDIKTI API (minta credential ke admin)
FEEDER_API_BASE_URL=https://dapelmikpdpt.unila.ac.id/New/ws/Api.php
FEEDER_WS_USERNAME=
FEEDER_WS_PASSWORD=
FEEDER_API_USERNAME=${FEEDER_WS_USERNAME}
FEEDER_API_PASSWORD=${FEEDER_WS_PASSWORD}

FEEDER_REDIS_HOST=${REDIS_HOST}
FEEDER_REDIS_PORT=${REDIS_PORT}

# ========================================
# MyUnila Service (Go + Fiber)
# ========================================
MYUNILA_APP_NAME="MyUnila Service - Local"
MYUNILA_APP_PORT=:8086
MYUNILA_APP_ENV=local

# SIKEP API Configuration (minta credential ke admin)
SIKEP_API_BASE_URL=https://sikep.unila.ac.id/2022/api/v1
SIKEP_API_USERNAME=
SIKEP_API_PASSWORD=

# Radius API Configuration (minta credential ke admin)
RADIUS_API_BASE_URL=https://akses.unila.ac.id/api/live/v1
RADIUS_API_APP_KEY=
RADIUS_API_USERNAME=

# ========================================
# Dashboard Service (Laravel)
# ========================================
DASHBOARD_APP_NAME="Dashboard Service - Local"
DASHBOARD_APP_ENV=local
DASHBOARD_APP_KEY=base64:Ni67WITr6h932ci73ilQeQkIEp6Qcu6LImnAAYyh4VI=
DASHBOARD_APP_DEBUG=true
DASHBOARD_APP_URL=http://localhost:8087

DASHBOARD_DB_CONNECTION=sqlsrv
DASHBOARD_DB_HOST=${DB_MSSQL_HOST}
DASHBOARD_DB_PORT=${DB_MSSQL_PORT}
DASHBOARD_DB_DATABASE=${DB_MSSQL_DATABASE}
DASHBOARD_DB_USERNAME=${DB_MSSQL_USERNAME}
DASHBOARD_DB_PASSWORD=${DB_MSSQL_PASSWORD}

DASHBOARD_REDIS_HOST=redis
DASHBOARD_REDIS_PORT=6379

# ========================================
# Keuangan Service (Go + Fiber)
# ========================================
KEUANGAN_APP_NAME="Keuangan Service - Local"
KEUANGAN_APP_PORT=:8088
KEUANGAN_APP_ENV=local

KEUANGAN_DB_DRIVER=sqlserver
KEUANGAN_DB_DATABASE=${DB_MSSQL_DATABASE}
KEUANGAN_DB_MAX_OPEN_CONNS=25
KEUANGAN_DB_MAX_IDLE_CONNS=5
KEUANGAN_DB_CONN_MAX_LIFETIME=5m

# SIMPEDAM API Configuration (minta credential ke admin)
SIMPEDAM_ENDPOINT=https://simpedam.unila.ac.id/ws/RestApi.php
SIMPEDAM_USER=
SIMPEDAM_PASSWORD=
SIMPEDAM_API_CODE=SIMPEDAM

# ========================================
# Application IDs (for logging)
# ========================================
APP_APLIKASI_ID=6df39588-e4d7-4e92-b3b1-e7b5078a3832

# ========================================
# Frontend API URLs (Mode Tanpa Kong)
# deploy-minimal.sh akan otomatis set ini.
# Uncomment manual jika ingin build frontend Docker tanpa Kong.
# ========================================
# NEXT_PUBLIC_API_URL=http://localhost:8081
# NEXT_PUBLIC_AUTH_API_URL=http://localhost:8081/api/v1
# NEXT_PUBLIC_PUBLIC_API_URL=http://localhost:8082/api/v1
# NEXT_PUBLIC_SISTER_API_URL=http://localhost:8083
# NEXT_PUBLIC_FEEDER_API_URL=http://localhost:8084
# NEXT_PUBLIC_MYUNILA_API_URL=http://localhost:8086
# NEXT_PUBLIC_KEUANGAN_API_URL=http://localhost:8088
# NEXT_PUBLIC_DASHBOARD_API_URL=http://localhost:8087/api/v1

# ============================================
# PostgreSQL (shared container for all PG services)
# ============================================
PG_SUPERUSER=postgres
PG_SUPERPASS=postgres
PG_PORT=5432

# ============================================
# SIMBAK Service (BAK)
# ============================================
BAK_APP_NAME="SIMBAK Service"
BAK_APP_ENV=local
BAK_APP_KEY=
BAK_APP_DEBUG=true
BAK_APP_URL=http://localhost:9002

# PostgreSQL (simbak)
BAK_DB_CONNECTION=pgsql
BAK_DB_HOST=postgres
BAK_DB_PORT=5432
BAK_DB_DATABASE=simbak
BAK_DB_USERNAME=myunila_bak
BAK_DB_PASSWORD=myunila_bak_local

# SQL Server (pdut — optional for local dev)
BAK_SQLSRV_HOST=192.168.123.119
BAK_SQLSRV_PORT=1433
BAK_SQLSRV_DATABASE=pdut_staging
BAK_SQLSRV_USERNAME=
BAK_SQLSRV_PASSWORD=

# Redis
BAK_REDIS_HOST=redis
BAK_REDIS_PORT=6379
