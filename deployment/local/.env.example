# ========================================
# MyUnila Local Development Environment
# ========================================

# Local Configuration
VM_IP=localhost
ENVIRONMENT=local

# ========================================
# External Database (SQL Server)
# Using credentials from backend/.env
# ========================================
DB_MSSQL_HOST=
DB_MSSQL_PORT=1433
DB_MSSQL_DATABASE=
DB_MSSQL_USERNAME=
DB_MSSQL_PASSWORD=

# Feeder Service - Testing Database (override)
FEEDER_DB_DATABASE=

# ========================================
# Kong Database (PostgreSQL)
# Using local or external Postgres
# ========================================
KONG_PG_HOST=
KONG_PG_PORT=5432
KONG_PG_DATABASE=
KONG_PG_USER=postgres
KONG_PG_PASSWORD=

# ========================================
# Redis Configuration
# ========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================================
# MeiliSearch Configuration
# ========================================
MEILI_ENV=development
MEILI_MASTER_KEY=
MEILISEARCH_HOST=
MEILISEARCH_KEY=

# ========================================
# Auth Service (Laravel)
# ========================================
AUTH_APP_NAME="MyUnila Auth Service - Local"
AUTH_APP_ENV=local
AUTH_APP_KEY=
AUTH_APP_DEBUG=true
AUTH_APP_URL=http://localhost:8081

AUTH_DB_CONNECTION=sqlsrv
AUTH_DB_HOST=
AUTH_DB_PORT=1433
AUTH_DB_DATABASE=
AUTH_DB_USERNAME=
AUTH_DB_PASSWORD=

AUTH_REDIS_HOST=${REDIS_HOST}
AUTH_REDIS_PORT=${REDIS_PORT}

# JWT Configuration
JWT_SECRET=
JWT_ISSUER=http://localhost:8081
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800
JWT_ALGORITHM=HS256

# SSO Configuration (from auth-service/.env)
SSO_UNILA_BASE_URL=https://akses.unila.ac.id
SSO_UNILA_APP_KEY=
SSO_UNILA_JWT_SECRET=
SSO_UNILA_CALLBACK_URL=http://localhost:8081/api/v1/auth/sso/callback

# ========================================
# Public Service (Laravel)
# ========================================
PUBLIC_APP_NAME="MyUnila Public Service - Local"
PUBLIC_APP_ENV=local
PUBLIC_APP_KEY=
PUBLIC_APP_DEBUG=true
PUBLIC_APP_URL=http://localhost:8082

PUBLIC_DB_CONNECTION=sqlsrv
PUBLIC_DB_HOST=
PUBLIC_DB_PORT=1433
PUBLIC_DB_DATABASE=
PUBLIC_DB_USERNAME=
PUBLIC_DB_PASSWORD=

PUBLIC_REDIS_HOST=redis
PUBLIC_REDIS_PORT=6379

# Institution ID (Universitas Lampung)
UNILA_ID_SP=E2B705A7-173E-464A-9FAC-509128709515

# Sister DB connection (for bidang ilmu and other SISTER data) - same as PUBLIC_DB
SISTER_DB_HOST=
SISTER_DB_PORT=1433
SISTER_DB_DATABASE=
SISTER_DB_USERNAME=
SISTER_DB_PASSWORD=

# SQL Server Connection Settings (for ODBC Driver 18)
# Encrypt: no (string) for SQL Server PDO connection
# TrustServerCertificate: yes (string) for SQL Server PDO connection
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# Base DB settings (used by Laravel public service)
DB_CONNECTION=sqlsrv
DB_HOST=
DB_PORT=1433
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ========================================
# Sister Service (Go + Fiber)
# ========================================
SISTER_APP_NAME="Sister Service - Local"
SISTER_APP_PORT=:8083
SISTER_APP_ENV=local

# Sister DB config moved to dashboard service section above (lines 96-100)
# to avoid duplicate variable definitions. Go service uses same SQL Server.
SISTER_DB_DRIVER=sqlserver
SISTER_DB_MAX_OPEN_CONNS=25
SISTER_DB_MAX_IDLE_CONNS=5
SISTER_DB_CONN_MAX_LIFETIME=5m

# SISTER API Kemdikbud (from sister-service env in docker-compose.yml)
SISTER_API_BASE_URL=https://sister-api.kemdiksaintek.go.id/ws.php
SISTER_API_IDPENGGUNA=125e6431-7727-402e-adb5-24d410af493c
SISTER_API_USERNAME=
SISTER_API_PASSWORD=

SISTER_REDIS_HOST=${REDIS_HOST}
SISTER_REDIS_PORT=${REDIS_PORT}

API_CONFIG_ENCRYPTION_KEY=

# Laravel APP_KEY for decrypting encrypted IDs from public-service
# Must be same as PUBLIC_APP_KEY (base64 encoded part only, without "base64:" prefix)
LARAVEL_APP_KEY=

# ========================================
# Feeder Service (Go + Fiber)
# ========================================
FEEDER_APP_NAME="Feeder Service - Local"
FEEDER_APP_PORT=:8084
FEEDER_APP_ENV=local

# Feeder DB config (same SQL Server as others)
# Note: FEEDER_DB_DATABASE is overridden above for testing (pdut)
FEEDER_DB_DRIVER=sqlserver
FEEDER_DB_HOST=
FEEDER_DB_PORT=${DB_MSSQL_PORT}
# FEEDER_DB_DATABASE=${DB_MSSQL_DATABASE}  # Commented - using override above
FEEDER_DB_USERNAME=
FEEDER_DB_PASSWORD=
FEEDER_DB_TRUST_SERVER_CERTIFICATE=true
FEEDER_DB_MAX_OPEN_CONNS=25
FEEDER_DB_MAX_IDLE_CONNS=5
FEEDER_DB_CONN_MAX_LIFETIME=5m

# Neo Feeder PDDIKTI API (Fallback - Priority: Database > Environment)
FEEDER_API_BASE_URL=https://dapelmikpdpt.unila.ac.id/New/ws/Api.php
FEEDER_WS_USERNAME=
FEEDER_WS_PASSWORD=
FEEDER_API_USERNAME=
FEEDER_API_PASSWORD=

FEEDER_REDIS_HOST=${REDIS_HOST}
FEEDER_REDIS_PORT=${REDIS_PORT}

# ========================================
# MyUnila Service (Go + Fiber)
# ========================================
MYUNILA_APP_NAME="MyUnila Service - Local"
MYUNILA_APP_PORT=:8086
MYUNILA_APP_ENV=local

# SIKEP API Configuration
# Note: Base URL includes /2022 prefix as per SIKEP API documentation
SIKEP_API_BASE_URL=https://sikep.unila.ac.id/2022/api/v1
SIKEP_API_USERNAME=
SIKEP_API_PASSWORD=

# Radius API Configuration (SSO Unila)
# Used by myunila-service for syncing radius/SSO user data
RADIUS_API_BASE_URL=
RADIUS_API_APP_KEY=
RADIUS_API_USERNAME=

# ========================================
# Keuangan Service (Go + Fiber)
# ========================================
KEUANGAN_APP_NAME="Keuangan Service - Local"
KEUANGAN_APP_PORT=:8088
KEUANGAN_APP_ENV=local

# Keuangan DB config (same SQL Server as others)
KEUANGAN_DB_DRIVER=sqlserver
KEUANGAN_DB_DATABASE=
KEUANGAN_DB_MAX_OPEN_CONNS=25
KEUANGAN_DB_MAX_IDLE_CONNS=5
KEUANGAN_DB_CONN_MAX_LIFETIME=5m

# SIMPEDAM API Configuration
# Web service untuk integrasi data keuangan mahasiswa (UKT, SPP)
SIMPEDAM_ENDPOINT=https://simpedam.unila.ac.id/ws/live2unila.php
SIMPEDAM_USER=
SIMPEDAM_PASSWORD=
SIMPEDAM_API_CODE=SIMPEDAM

# ========================================
# Application IDs (for logging)
# ========================================
APP_APLIKASI_ID=
