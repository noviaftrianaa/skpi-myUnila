# ========================================
# MyUnila Local Development Environment
# ========================================
# Copy this file to .env and fill in the values

# Local Configuration
VM_IP=localhost
ENVIRONMENT=local

# ========================================
# External Database (SQL Server)
# ========================================
DB_MSSQL_HOST=
DB_MSSQL_PORT=1433
DB_MSSQL_DATABASE=
DB_MSSQL_USERNAME=
DB_MSSQL_PASSWORD=

# Feeder Service - Testing Database (override)
FEEDER_DB_DATABASE=

# ========================================
# Kong Database (PostgreSQL)
# ========================================
KONG_PG_HOST=host.docker.internal
KONG_PG_PORT=5432
KONG_PG_DATABASE=kong_local
KONG_PG_USER=postgres
KONG_PG_PASSWORD=

# ========================================
# Redis Configuration
# ========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================================
# MeiliSearch Configuration
# ========================================
MEILI_ENV=development
MEILI_MASTER_KEY=
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=

# ========================================
# Auth Service (Laravel)
# ========================================
AUTH_APP_NAME="MyUnila Auth Service - Local"
AUTH_APP_ENV=local
AUTH_APP_KEY=
AUTH_APP_DEBUG=true
AUTH_APP_URL=http://localhost:8081

AUTH_DB_CONNECTION=sqlsrv
AUTH_DB_HOST=
AUTH_DB_PORT=1433
AUTH_DB_DATABASE=
AUTH_DB_USERNAME=
AUTH_DB_PASSWORD=

AUTH_REDIS_HOST=${REDIS_HOST}
AUTH_REDIS_PORT=${REDIS_PORT}

# JWT Configuration
JWT_SECRET=
JWT_ISSUER=http://localhost:8081
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800
JWT_ALGORITHM=HS256

# Radius Database Configuration (MySQL - SSO)
RADIUS_DB_HOST=
RADIUS_DB_PORT=3306
RADIUS_DB_DATABASE=radius
RADIUS_DB_USERNAME=
RADIUS_DB_PASSWORD=

# SSO Configuration
SSO_UNILA_BASE_URL=https://akses.unila.ac.id
SSO_UNILA_APP_KEY=
SSO_UNILA_JWT_SECRET=
SSO_UNILA_CALLBACK_URL=http://localhost:8081/api/v1/auth/sso/callback

# ========================================
# Dashboard Service (Laravel)
# ========================================
DASHBOARD_APP_NAME="MyUnila Dashboard Service - Local"
DASHBOARD_APP_ENV=local
DASHBOARD_APP_KEY=
DASHBOARD_APP_DEBUG=true
DASHBOARD_APP_URL=http://localhost:8082

DASHBOARD_DB_CONNECTION=sqlsrv
DASHBOARD_DB_HOST=
DASHBOARD_DB_PORT=1433
DASHBOARD_DB_DATABASE=
DASHBOARD_DB_USERNAME=
DASHBOARD_DB_PASSWORD=

DASHBOARD_REDIS_HOST=redis
DASHBOARD_REDIS_PORT=6379

# Institution ID (Universitas Lampung)
UNILA_ID_SP=

# Sister DB connection
SISTER_DB_HOST=
SISTER_DB_PORT=1433
SISTER_DB_DATABASE=
SISTER_DB_USERNAME=
SISTER_DB_PASSWORD=

# SQL Server Connection Settings
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# Base DB settings
DB_CONNECTION=sqlsrv
DB_HOST=
DB_PORT=1433
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ========================================
# Sister Service (Go + Fiber)
# ========================================
SISTER_APP_NAME="Sister Service - Local"
SISTER_APP_PORT=:8083
SISTER_APP_ENV=local

SISTER_DB_DRIVER=sqlserver
SISTER_DB_MAX_OPEN_CONNS=25
SISTER_DB_MAX_IDLE_CONNS=5
SISTER_DB_CONN_MAX_LIFETIME=5m

# SISTER API Kemdikbud
SISTER_API_BASE_URL=https://sister-api.kemdikbud.go.id/ws.php
SISTER_API_IDPENGGUNA=
SISTER_API_USERNAME=
SISTER_API_PASSWORD=

SISTER_REDIS_HOST=${REDIS_HOST}
SISTER_REDIS_PORT=${REDIS_PORT}

API_CONFIG_ENCRYPTION_KEY=

# Laravel APP_KEY for decrypting encrypted IDs
LARAVEL_APP_KEY=

# ========================================
# Feeder Service (Go + Fiber)
# ========================================
FEEDER_APP_NAME="Feeder Service - Local"
FEEDER_APP_PORT=:8084
FEEDER_APP_ENV=local

FEEDER_DB_DRIVER=sqlserver
FEEDER_DB_HOST=${DB_MSSQL_HOST}
FEEDER_DB_PORT=${DB_MSSQL_PORT}
FEEDER_DB_USERNAME=${DB_MSSQL_USERNAME}
FEEDER_DB_PASSWORD=${DB_MSSQL_PASSWORD}
FEEDER_DB_TRUST_SERVER_CERTIFICATE=true
FEEDER_DB_MAX_OPEN_CONNS=25
FEEDER_DB_MAX_IDLE_CONNS=5
FEEDER_DB_CONN_MAX_LIFETIME=5m

# Neo Feeder PDDIKTI API
FEEDER_API_BASE_URL=
FEEDER_WS_USERNAME=
FEEDER_WS_PASSWORD=
FEEDER_API_USERNAME=${FEEDER_WS_USERNAME}
FEEDER_API_PASSWORD=${FEEDER_WS_PASSWORD}

FEEDER_REDIS_HOST=${REDIS_HOST}
FEEDER_REDIS_PORT=${REDIS_PORT}

# ========================================
# MyUnila Service (Go + Fiber)
# ========================================
MYUNILA_APP_NAME="MyUnila Service - Local"
MYUNILA_APP_PORT=:8086
MYUNILA_APP_ENV=local

# SIKEP API Configuration
SIKEP_API_BASE_URL=https://sikep.unila.ac.id/2022/api/v1
SIKEP_API_USERNAME=
SIKEP_API_PASSWORD=

# Radius API Configuration (SSO Unila)
# Used by myunila-service for syncing radius/SSO user data
RADIUS_API_BASE_URL=https://akses.unila.ac.id/api/live/v1
RADIUS_API_APP_KEY=
RADIUS_API_USERNAME=

# ========================================
# Application IDs (for logging)
# ========================================
APP_APLIKASI_ID=00000000-0000-0000-0000-000000000001
