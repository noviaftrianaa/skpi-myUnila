# ============================================
# VM3 - Backend Services 2 Configuration
# Server: 192.168.120.43
# User: mybackend2
# Services: Sister, Feeder, MyUnila, API, Keuangan, Monitoring
# ============================================

# Server Information
VM_IP=192.168.120.43
TIMEZONE=Asia/Jakarta

# ============================================
# Sister Service Configuration (Go Application)
# ============================================
SISTER_SERVICE_PORT=8083

# Application Config
APP_NAME=Sister Service
APP_PORT=:8083
APP_ENV=production
APP_DEBUG=false

# API Config Encryption Key (MUST be exactly 32 characters for AES-256)
# Generate with: openssl rand -base64 32 | head -c 32
API_CONFIG_ENCRYPTION_KEY=

# Laravel APP_KEY for decrypting encrypted IDs from public-service
# Must be same as PUBLIC_APP_KEY (base64 encoded part only, without "base64:" prefix)
LARAVEL_APP_KEY=

# Sister API Kemdikbud (fallback when database config not set)
SISTER_API_BASE_URL=https://sister-api.kemdiktisaintek.go.id/ws.php
SISTER_API_IDPENGGUNA=
SISTER_API_USERNAME=
SISTER_API_PASSWORD=

# Database Configuration - Sister Service (SQL Server - 192.168.123.119)
SISTER_DB_CONNECTION=sqlsrv
SISTER_DB_DRIVER=sqlserver
SISTER_DB_HOST=192.168.123.119
SISTER_DB_PORT=1433
SISTER_DB_DATABASE=db_sister_prod
SISTER_DB_USERNAME=
SISTER_DB_PASSWORD=

# Database Connection Pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Sister Service API Configuration
SISTER_SERVICE_URL=http://192.168.120.43:8083

# ============================================
# MinIO Object Storage (Photo Storage)
# Server: 192.168.120.47
# ============================================
MINIO_ENDPOINT=192.168.120.47:9000
MINIO_ACCESS_KEY=myunila-api-access
MINIO_SECRET_KEY=
MINIO_BUCKET=myunila-storage
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://192.168.120.47:9000

# ============================================
# Meilisearch Configuration
# ============================================
MEILISEARCH_HOST=http://192.168.123.190:7700
MEILISEARCH_KEY=

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=192.168.123.190
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=
JWT_TTL=3600

# ============================================
# Kong Gateway Configuration
# ============================================
KONG_ADMIN_URL=http://192.168.120.41:9801
KONG_PROXY_URL=http://192.168.120.41:9800

# ============================================
# Laravel Configuration
# ============================================
APP_NAME="Sister Service"
APP_ENV=production
APP_KEY=base64:your_app_key_here_32_characters
APP_DEBUG=false
APP_URL=http://192.168.120.43:8083

LOG_CHANNEL=stack
LOG_LEVEL=error

# ============================================
# Network Configuration
# ============================================
NETWORK_NAME=myunila-prod-network

# ============================================
# Feeder Service Configuration (Go Application)
# ============================================
FEEDER_SERVICE_PORT=8084

# Application Config
FEEDER_APP_NAME=Feeder Service
FEEDER_APP_PORT=:8084
FEEDER_APP_ENV=production

# Feeder PDDIKTI API (fallback when database config not set)
FEEDER_API_BASE_URL=https://dapelmikpdpt.unila.ac.id/New/ws/Api.php
FEEDER_API_USERNAME=
FEEDER_API_PASSWORD=

# Database Configuration - Feeder Service (SQL Server - 192.168.123.119)
FEEDER_DB_DRIVER=sqlserver
FEEDER_DB_HOST=192.168.123.119
FEEDER_DB_PORT=1433
FEEDER_DB_DATABASE=db_feeder_prod
FEEDER_DB_USERNAME=
FEEDER_DB_PASSWORD=
FEEDER_DB_TRUST_SERVER_CERTIFICATE=true

# Database Connection Pool - Feeder
FEEDER_DB_MAX_OPEN_CONNS=100
FEEDER_DB_MAX_IDLE_CONNS=20
FEEDER_DB_CONN_MAX_LIFETIME=5m

# Feeder Service API Configuration
FEEDER_SERVICE_URL=http://192.168.120.43:8084

# ============================================
# MyUnila Service Configuration (Go Application)
# ============================================
MYUNILA_SERVICE_PORT=8086

# Application Config
MYUNILA_APP_NAME=MyUnila Service
MYUNILA_APP_PORT=:8086
MYUNILA_APP_ENV=production

# Database Configuration - MyUnila Service (SQL Server - 192.168.123.119)
# Uses same database as Sister/Feeder if not specified
MYUNILA_DB_DRIVER=sqlserver
MYUNILA_DB_HOST=192.168.123.119
MYUNILA_DB_PORT=1433
MYUNILA_DB_DATABASE=pdut_prod
MYUNILA_DB_USERNAME=
MYUNILA_DB_PASSWORD=

# SIKEP API Configuration
SIKEP_API_BASE_URL=https://sikep.unila.ac.id/2022/api/v1
SIKEP_API_USERNAME=
SIKEP_API_PASSWORD=

# Radius API Configuration (SSO Unila)
# Used by myunila-service for syncing radius/SSO user data
RADIUS_API_BASE_URL=https://akses.unila.ac.id/api/live/v1
RADIUS_API_APP_KEY=
RADIUS_API_USERNAME=

# MyUnila Service API Configuration
MYUNILA_SERVICE_URL=http://192.168.120.43:8086

# ============================================
# API Service Configuration (Go Application - OneData)
# ============================================
API_SERVICE_PORT=8085

# Application Config
API_APP_NAME=MyUnila API Service
API_APP_PORT=:8085
API_APP_ENV=production
API_APP_URL=http://192.168.120.43:8085

# Database Configuration - API Service (SQL Server - 192.168.123.119)
API_DB_DRIVER=sqlserver
API_DB_HOST=192.168.123.119
API_DB_PORT=1433
API_DB_DATABASE=pdut_prod
API_DB_USERNAME=
API_DB_PASSWORD=
API_REDIS_DB=2

# Auth Cache Prefix (for reading user context from auth-service)
AUTH_CACHE_PREFIX=auth_

# API Service URL
API_SERVICE_URL=http://192.168.120.43:8085

# ============================================
# Keuangan Service Configuration (Go Application)
# ============================================
KEUANGAN_SERVICE_PORT=8088

# Application Config
KEUANGAN_APP_NAME=Keuangan Service
KEUANGAN_APP_PORT=:8088
KEUANGAN_APP_ENV=production

# Database Configuration - Keuangan Service (SQL Server - 192.168.123.119)
KEUANGAN_DB_DRIVER=sqlserver
KEUANGAN_DB_HOST=192.168.123.119
KEUANGAN_DB_PORT=1433
KEUANGAN_DB_DATABASE=pdut_prod
KEUANGAN_DB_USERNAME=
KEUANGAN_DB_PASSWORD=

# Database Connection Pool - Keuangan
KEUANGAN_DB_MAX_OPEN_CONNS=25
KEUANGAN_DB_MAX_IDLE_CONNS=5
KEUANGAN_DB_CONN_MAX_LIFETIME=5m

# SIMPEDAM API Configuration
# Web service untuk integrasi data keuangan mahasiswa (UKT, SPP)
SIMPEDAM_ENDPOINT=https://simpedam.unila.ac.id/ws/live2unila.php
SIMPEDAM_USER=
SIMPEDAM_PASSWORD=
SIMPEDAM_API_CODE=SIMPEDAM

# Keuangan Service API Configuration
KEUANGAN_SERVICE_URL=http://192.168.120.43:8088

# ============================================
# Monitoring Service Configuration (Go Application)
# Port: 8089
# ============================================
MONITORING_APP_NAME=Monitoring Service
MONITORING_APP_PORT=:8089
MONITORING_APP_ENV=production

# Database Configuration - Monitoring Service (SQL Server - schema: monitoring)
MONITORING_DB_DRIVER=sqlserver
MONITORING_DB_HOST=192.168.123.119
MONITORING_DB_PORT=1433
MONITORING_DB_DATABASE=pdut_prod
MONITORING_DB_USERNAME=
MONITORING_DB_PASSWORD=

# Database Connection Pool
MONITORING_DB_MAX_OPEN_CONNS=25
MONITORING_DB_MAX_IDLE_CONNS=5
MONITORING_DB_CONN_MAX_LIFETIME=5m

# JWT (must match auth-service JWT_SECRET)
# JWT_SECRET already defined above (shared)

# Blogger API (untuk sync konten dari website Blogger unit)
BLOGGER_API_KEY=

# Google Search Console — URL Removal API
# Service account JSON file harus di-copy ke:
# /var/www/my-unila/deployment/production/vm3-backend2/secrets/gsc-service-account.json
GSC_SERVICE_ACCOUNT_JSON=/app/secrets/gsc-service-account.json
GSC_SITE_URL=sc-domain:unila.ac.id
GSC_AUTO_REMOVE_THRESHOLD=15
GSC_ENABLED=false

# Crawler Settings
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_PAGES=500
CRAWLER_RATE_LIMIT_MS=1000
CRAWLER_CONCURRENT_SITES=3
CRAWLER_TIMEOUT_SEC=30

# Deep Scan: Cloaking Detection (dual User-Agent scan)
CRAWLER_CLOAKING_ENABLED=true
CRAWLER_CLOAKING_THRESHOLD=0.7

# Deep Scan: AMP Cache Scan
CRAWLER_AMP_SCAN_ENABLED=true

# Monitoring Service URL
MONITORING_SERVICE_URL=http://192.168.120.43:8089

# ============================================
# Future Services (Placeholder)
# ============================================
# Scheduler
SCHEDULER_ENABLED=false
