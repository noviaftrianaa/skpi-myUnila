# ============================================
# vm9-blog (192.168.120.49) — Blog Platform
# ============================================
# Copy ke .env, set value production.
# JANGAN commit .env ke git (sudah di .gitignore).

# ----- PostgreSQL (blog_unila) -----
POSTGRES_PASSWORD=__set_in_production__

# ----- JWT shared with auth-service MyUnila -----
# Sama dengan vm2 auth-service untuk Kong-trust pattern
JWT_SECRET=__same_as_auth_service__

# ----- MinIO (object storage shared) -----
MINIO_ENDPOINT=https://minio.unila.ac.id
MINIO_ACCESS_KEY=__set__
MINIO_SECRET_KEY=__set__
MINIO_BUCKET=blog-media

# ----- Meilisearch (shared di vm2) -----
MEILI_HOST=http://192.168.120.42:7700
MEILI_API_KEY=__admin_master_key__
MEILI_SEARCH_KEY=__public_search_only_key__

# ----- pdut (cross-DB read-only ke SQL Server) -----
PDUT_DB_HOST=192.168.123.119
PDUT_DB_PORT=1433
PDUT_DB_NAME=pdut
PDUT_DB_USER=__readonly_user__
PDUT_DB_PASSWORD=__set__

# ----- Webhook secret untuk on-demand revalidation Next.js -----
# Random 64 char (gunakan: openssl rand -hex 32)
REVALIDATE_SECRET=__random_64char__

# ----- Frontend-Blog -----
NEXT_PUBLIC_BLOG_API=https://api.blog.unila.ac.id
NEXT_PUBLIC_APEX_HOST=blog.unila.ac.id
NEXT_PUBLIC_USE_MOCK=false

# ----- Timezone -----
TZ=Asia/Jakarta
