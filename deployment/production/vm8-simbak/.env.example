# ============================================
# VM8 - SIMBAK Service Configuration
# Server: 192.168.120.48 (TBD — request ke infra)
# User: mysimbak
# Services: SIMBAK (Laravel), Nginx, PostgreSQL, Redis
# ============================================

# Server Information
VM_IP=192.168.120.48
TIMEZONE=Asia/Jakarta

# ============================================
# PostgreSQL (SIMBAK — primary, local on VM8)
# ============================================
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=simbak
PG_USERNAME=myunila_bak
PG_PASSWORD=

# Postgres container init
POSTGRES_DB=simbak
POSTGRES_USER=myunila_bak
POSTGRES_PASSWORD=

# ============================================
# SQL Server (pdut — read only reference)
# ============================================
SQLSRV_HOST=192.168.123.119
SQLSRV_PORT=1433
SQLSRV_DATABASE=pdut
SQLSRV_USERNAME=
SQLSRV_PASSWORD=
SQLSRV_TRUST_SERVER_CERTIFICATE=true

# ============================================
# Laravel App
# ============================================
APP_NAME="SIMBAK Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://192.168.120.48:9002

# ============================================
# JWT (validation only — token dari auth-service)
# ============================================
JWT_SECRET=
JWT_ALGO=HS256

# ============================================
# Redis (local on VM8)
# ============================================
REDIS_HOST=myunila-simbak-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# MinIO Object Storage (VM7)
# ============================================
MINIO_ENDPOINT=http://192.168.120.47:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=myunila-storage
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# ============================================
# Logging
# ============================================
LOG_CHANNEL=stack
LOG_LEVEL=info

# ============================================
# SI KKN Service (added 2026-05-07)
# Container: myunila-si-kkn-service (port 9004)
# DB: sikkn_myunila (own postgres container, port 5434)
# Redis: own redis container (port 6381)
# ============================================
SI_KKN_APP_NAME="SI KKN Service"
SI_KKN_APP_KEY=
SI_KKN_APP_DEBUG=false
SI_KKN_APP_URL=http://192.168.120.48:9004

SI_KKN_PG_HOST=myunila-si-kkn-postgres
SI_KKN_PG_PORT=5432
SI_KKN_PG_DATABASE=sikkn_myunila
SI_KKN_PG_USERNAME=myunila_kkn
SI_KKN_PG_PASSWORD=

SI_KKN_REDIS_HOST=myunila-si-kkn-redis
SI_KKN_REDIS_PORT=6379
SI_KKN_REDIS_PASSWORD=

SI_KKN_FILESYSTEM_DISK=kkn

# KKN WS API (legacy MySQL eKKN, optional)
KKN_WS_API_BASE_URL=
KKN_WS_API_USERNAME=
KKN_WS_API_PASSWORD=
