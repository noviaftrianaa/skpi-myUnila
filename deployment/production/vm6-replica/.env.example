# ============================================
# VM6 - Replica Backend Services (Active-Active with VM3)
# Server: 192.168.120.46
# User: myreplica
# Services: Mirror of VM3 (Sister, Feeder, MyUnila, API, Keuangan, Monitoring, Project)
# ============================================
# IMPORTANT: This .env MUST mirror VM3's .env values
# All services are stateless — they connect to the same DB + Redis as VM3
# ============================================

VM_IP=192.168.120.46
TIMEZONE=Asia/Jakarta

# ============================================
# Sister Service (port 8091)
# ============================================
SISTER_SERVICE_PORT=8091
APP_PORT=:8091

# Sister API Kemdikbud
SISTER_API_BASE_URL=https://sister-api.kemdiktisaintek.go.id/ws.php
SISTER_API_IDPENGGUNA=
SISTER_API_USERNAME=
SISTER_API_PASSWORD=

# API Config Encryption Key (SAME as VM3)
API_CONFIG_ENCRYPTION_KEY=
LARAVEL_APP_KEY=

# DB Sister (SQL Server 119)
SISTER_DB_DRIVER=sqlserver
SISTER_DB_HOST=192.168.123.119
SISTER_DB_PORT=1433
SISTER_DB_DATABASE=db_sister_prod
SISTER_DB_USERNAME=
SISTER_DB_PASSWORD=

# DB Pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# ============================================
# Feeder Service (port 8092)
# ============================================
FEEDER_SERVICE_PORT=8092
FEEDER_APP_PORT=:8092

FEEDER_API_BASE_URL=https://dapelmikpdpt.unila.ac.id/New/ws/Api.php
FEEDER_API_USERNAME=
FEEDER_API_PASSWORD=

FEEDER_DB_DRIVER=sqlserver
FEEDER_DB_HOST=192.168.123.119
FEEDER_DB_PORT=1433
FEEDER_DB_DATABASE=db_feeder_prod
FEEDER_DB_USERNAME=
FEEDER_DB_PASSWORD=
FEEDER_DB_TRUST_SERVER_CERTIFICATE=true
FEEDER_DB_MAX_OPEN_CONNS=100
FEEDER_DB_MAX_IDLE_CONNS=20
FEEDER_DB_CONN_MAX_LIFETIME=5m

# ============================================
# MyUnila Service (port 8093)
# ============================================
MYUNILA_SERVICE_PORT=8093
MYUNILA_APP_PORT=:8093

MYUNILA_DB_DRIVER=sqlserver
MYUNILA_DB_HOST=192.168.123.119
MYUNILA_DB_PORT=1433
MYUNILA_DB_DATABASE=pdut
MYUNILA_DB_USERNAME=
MYUNILA_DB_PASSWORD=

SIKEP_API_BASE_URL=https://sikep.unila.ac.id/2022/api/v1
SIKEP_API_USERNAME=
SIKEP_API_PASSWORD=

RADIUS_API_BASE_URL=https://akses.unila.ac.id/api/live/v1
RADIUS_API_APP_KEY=
RADIUS_API_USERNAME=

# ============================================
# API Service / WS Service (port 8094)
# ============================================
API_SERVICE_PORT=8094
API_APP_PORT=:8094
API_APP_ENV=production

API_DB_DRIVER=sqlserver
API_DB_HOST=192.168.123.119
API_DB_PORT=1433
API_DB_DATABASE=pdut
API_DB_USERNAME=
API_DB_PASSWORD=
API_REDIS_DB=1

AUTH_CACHE_PREFIX=myunila_database_myunila_cache_

# WS Authorization
WS_AUTH_ENABLED=true
WS_AUTH_APP_ID=

# ============================================
# Keuangan Service (port 8096)
# ============================================
KEUANGAN_SERVICE_PORT=8096
KEUANGAN_APP_PORT=:8096

KEUANGAN_DB_DRIVER=sqlserver
KEUANGAN_DB_HOST=192.168.123.119
KEUANGAN_DB_PORT=1433
KEUANGAN_DB_DATABASE=pdut
KEUANGAN_DB_USERNAME=
KEUANGAN_DB_PASSWORD=
KEUANGAN_DB_MAX_OPEN_CONNS=25
KEUANGAN_DB_MAX_IDLE_CONNS=5
KEUANGAN_DB_CONN_MAX_LIFETIME=5m

SIMPEDAM_ENDPOINT=https://simpedam.unila.ac.id/ws/live2unila.php
SIMPEDAM_USER=
SIMPEDAM_PASSWORD=
SIMPEDAM_API_CODE=SIMPEDAM

# ============================================
# Monitoring Service (port 8097)
# ============================================
MONITORING_APP_PORT=:8097

MONITORING_DB_DRIVER=sqlserver
MONITORING_DB_HOST=192.168.123.119
MONITORING_DB_PORT=1433
MONITORING_DB_DATABASE=pdut
MONITORING_DB_USERNAME=
MONITORING_DB_PASSWORD=
MONITORING_DB_MAX_OPEN_CONNS=25
MONITORING_DB_MAX_IDLE_CONNS=5
MONITORING_DB_CONN_MAX_LIFETIME=5m

BLOGGER_API_KEY=
GSC_ENABLED=false

# ============================================
# Project Service (port 8095)
# ============================================
PROJECT_PG_DATABASE=myunila_project
PROJECT_PG_USERNAME=myunila_pm
PROJECT_PG_PASSWORD=
# NOTE: PG_HOST harus ke VM3 (192.168.120.43) karena PostgreSQL di VM3
PROJECT_PG_HOST=192.168.120.43

# ============================================
# Shared Infrastructure (SAME as VM3)
# ============================================

# MinIO (VM7)
MINIO_ENDPOINT=192.168.120.47:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=myunila-storage
MINIO_USE_SSL=false

# Redis (VM2)
REDIS_HOST=192.168.120.42
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (SAME as VM3)
JWT_SECRET=

# Kong
KONG_ADMIN_URL=http://192.168.120.41:9801
KONG_PROXY_URL=http://192.168.120.41:9800

# Network
NETWORK_NAME=myunila-prod-network

# Telegram (Project)
TELEGRAM_BOT_TOKEN=
PROJECT_TELEGRAM_CHAT_ID=
PROJECT_TELEGRAM_NOTIFY_ENABLED=false
