# ============================================
# VM4 Monitoring Stack — Environment Variables
# Copy ke .env dan isi nilainya
# JANGAN commit file .env!
# ============================================

# Grafana Admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ganti_dengan_password_kuat

# Telegram Alertmanager
TELEGRAM_BOT_TOKEN=isi_bot_token_dari_botfather
TELEGRAM_CHAT_ID=isi_chat_id_telegram

# Timezone
TZ=Asia/Jakarta
