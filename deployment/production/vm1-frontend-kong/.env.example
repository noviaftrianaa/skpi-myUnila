# ============================================
# VM1 - Frontend & Kong Gateway Configuration
# Server: 192.168.120.41
# User: myfrontend
# Services: Kong Gateway, Frontend Next.js, PostgreSQL (for Kong only)
# ============================================

# Server Information
VM_IP=192.168.120.41
TIMEZONE=Asia/Jakarta

# ============================================
# Kong Gateway Configuration
# ============================================
# Kong PostgreSQL (local, for Kong only)
KONG_PG_HOST=myunila-kong-postgres
KONG_PG_PORT=5432
KONG_PG_DATABASE=kong_prod
KONG_PG_USER=kong
KONG_PG_PASSWORD=

KONG_PROXY_PORT=9800
KONG_ADMIN_PORT=9801

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_PORT=3000

# API Endpoints (via Kong Gateway)
# Note: Frontend URLs MUST include /api/v1 - Kong strips service prefix and forwards remaining path
# Example: Frontend calls /auth-service/api/v1/auth/login → Kong forwards /api/v1/auth/login to backend
NEXT_PUBLIC_API_URL=http://192.168.120.41:9800
NEXT_PUBLIC_AUTH_API_URL=http://192.168.120.41:9800/auth-service/api/v1
NEXT_PUBLIC_PUBLIC_API_URL=http://192.168.120.41:9800/public-service/api/v1
NEXT_PUBLIC_SISTER_API_URL=http://192.168.120.41:9800/sister-service
NEXT_PUBLIC_FEEDER_API_URL=http://192.168.120.41:9800/feeder-service
NEXT_PUBLIC_MYUNILA_API_URL=http://192.168.120.41:9800/myunila-service

# ============================================
# Backend Service URLs (for Kong upstream)
# ============================================
# Note: Kong strips /auth-service prefix and forwards remaining path to upstream
# Kong routing: /auth-service/api/v1/* → upstream/api/v1/*
PUBLIC_SERVICE_URL=http://192.168.120.42:8082
AUTH_SERVICE_URL=http://192.168.120.42:8081
SISTER_SERVICE_URL=http://192.168.120.43:8083
FEEDER_SERVICE_URL=http://192.168.120.43:8084
MYUNILA_SERVICE_URL=http://192.168.120.43:8086

# ============================================
# External Services (Shared Infrastructure at 192.168.123.190)
# ============================================
# Redis
REDIS_HOST=192.168.123.190
REDIS_PORT=6379
REDIS_PASSWORD=

# Meilisearch
MEILISEARCH_HOST=http://192.168.123.190:7700
MEILISEARCH_KEY=

# SQL Server
DB_MSSQL_HOST=192.168.123.190
DB_MSSQL_PORT=1433
DB_MSSQL_DATABASE=pdut_prod
DB_MSSQL_USERNAME=
DB_MSSQL_PASSWORD=

# ============================================
# Network Configuration
# ============================================
NETWORK_NAME=myunila-prod-network
