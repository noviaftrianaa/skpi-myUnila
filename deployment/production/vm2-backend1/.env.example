RADIUS_DB_DATABASE=radius
RADIUS_DB_USERNAME=mybackend2
RADIUS_DB_PASSWORD=your-radius-password-here

# ============================================
# Application Configuration
# ============================================
APP_NAME=MyUnila
APP_ENV=production
APP_DEBUG=false
APP_URL=http://192.168.120.42

# Public Service (formerly Dashboard)
PUBLIC_APP_KEY=base64:generate_new_key_here
PUBLIC_APP_PORT=9000

# Auth Service
AUTH_APP_KEY=base64:generate_new_key_here
AUTH_APP_PORT=9000

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=
JWT_EXPIRATION=3600
JWT_ALGORITHM=HS256

# ============================================
# Meilisearch Configuration
# ============================================
MEILISEARCH_HOST=http://192.168.123.190:7700
MEILISEARCH_KEY=
MEILISEARCH_ENV=production

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=192.168.123.190
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# Dashboard Service
# ============================================
DASHBOARD_APP_KEY=base64:generate_new_key_here
DASHBOARD_APP_PORT=9000

DASHBOARD_DB_HOST=192.168.123.190
DASHBOARD_DB_PORT=1433
DASHBOARD_DB_USERNAME=
DASHBOARD_DB_PASSWORD=
DASHBOARD_DB_DATABASE=pdut_prod

# ============================================
# API Service (Go - OneData)
# ============================================
