# ============================================
# VM2 - Backend Services 1 Configuration
# Server: 192.168.120.42
# User: mybackend1
# Services: Dashboard Service, Auth Service, Nginx
# ============================================

# Server Information
VM_IP=192.168.120.42
TIMEZONE=Asia/Jakarta

# ============================================
# Database Configuration (SQL Server - 192.168.123.119)
# ============================================
DB_MSSQL_HOST=192.168.123.119
DB_MSSQL_PORT=1433
DB_MSSQL_USERNAME=
DB_MSSQL_PASSWORD=

# Public Service Database (formerly Dashboard)
PUBLIC_DB_HOST=192.168.123.119
PUBLIC_DB_PORT=1433
PUBLIC_DB_USERNAME=
PUBLIC_DB_PASSWORD=
PUBLIC_DB_DATABASE=pdut_prod

# Auth Database (SQL Server - Main)
AUTH_DB_HOST=192.168.123.119
AUTH_DB_PORT=1433
AUTH_DB_USERNAME=
AUTH_DB_PASSWORD=
AUTH_DB_DATABASE=pdut_prod
AUTH_APLIKASI_ID=6df39588-e4d7-4e92-b3b1-e7b5078a3832

# Radius Database (MySQL - SSO)
RADIUS_DB_HOST=192.168.1.42
RADIUS_DB_PORT=3306
RADIUS_DB_DATABASE=radius
RADIUS_DB_USERNAME=mybackend2
RADIUS_DB_PASSWORD=your-radius-password-here

# ============================================
# Application Configuration
# ============================================
APP_NAME=MyUnila
APP_ENV=production
APP_DEBUG=false
APP_URL=http://192.168.120.42

# Public Service (formerly Dashboard)
PUBLIC_APP_KEY=base64:generate_new_key_here
PUBLIC_APP_PORT=9000

# Auth Service
AUTH_APP_KEY=base64:generate_new_key_here
AUTH_APP_PORT=9000

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=
JWT_EXPIRATION=3600
JWT_ALGORITHM=HS256

# ============================================
# Meilisearch Configuration
# ============================================
MEILISEARCH_HOST=http://192.168.123.190:7700
MEILISEARCH_KEY=
MEILISEARCH_ENV=production

# ============================================
# Redis Configuration (Use local Redis container on VM2)
# ============================================
REDIS_HOST=myunila-redis-vm2
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# Dashboard Service
# ============================================
DASHBOARD_APP_KEY=base64:generate_new_key_here
DASHBOARD_APP_PORT=9000

DASHBOARD_DB_HOST=192.168.123.119
DASHBOARD_DB_PORT=1433
DASHBOARD_DB_USERNAME=
DASHBOARD_DB_PASSWORD=
DASHBOARD_DB_DATABASE=pdut_prod

# ============================================
# MinIO Object Storage (Photo Dosen)
# ============================================
MINIO_PUBLIC_URL=https://my.unila.ac.id/gateway/storage
MINIO_BUCKET=myunila-storage

# ============================================
# Nginx Configuration
# ============================================
NGINX_AUTH_PORT=8081
NGINX_PUBLIC_PORT=8082
NGINX_DASHBOARD_PORT=8086

# ============================================
# Network Configuration
# ============================================
NETWORK_NAME=myunila-prod-network
