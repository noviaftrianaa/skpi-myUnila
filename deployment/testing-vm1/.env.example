# ========================================
# MyUnila Testing VM1 Environment Variables
# ========================================

# VM Configuration
VM_IP=192.168.123.172
ENVIRONMENT=testing

# ========================================
# External Database (SQL Server)
# ========================================
DB_MSSQL_HOST=192.168.123.119
DB_MSSQL_PORT=1433
DB_MSSQL_DATABASE=pdut_dev
DB_MSSQL_USERNAME=mizarzulmi
DB_MSSQL_PASSWORD=Fogging204

# ========================================
# Kong Database (PostgreSQL)
# ========================================
KONG_PG_HOST=postgres-kong
KONG_PG_PORT=5432
KONG_PG_DATABASE=kong
KONG_PG_USER=kong
KONG_PG_PASSWORD=kong_secure_password_2024

# ========================================
# Redis Configuration
# ========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================================
# Auth Service (Laravel)
# ========================================
AUTH_APP_NAME="MyUnila Auth Service"
AUTH_APP_ENV=production
AUTH_APP_KEY=base64:your-generated-app-key-here
AUTH_APP_DEBUG=false
AUTH_APP_URL=http://${VM_IP}:8081

AUTH_DB_CONNECTION=sqlsrv
AUTH_DB_HOST=${DB_MSSQL_HOST}
AUTH_DB_PORT=${DB_MSSQL_PORT}
AUTH_DB_DATABASE=${DB_MSSQL_DATABASE}
AUTH_DB_USERNAME=${DB_MSSQL_USERNAME}
AUTH_DB_PASSWORD=${DB_MSSQL_PASSWORD}

AUTH_REDIS_HOST=${REDIS_HOST}
AUTH_REDIS_PORT=${REDIS_PORT}

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800
JWT_ALGORITHM=HS256

# ========================================
# Dashboard Service (Laravel)
# ========================================
DASHBOARD_APP_NAME="MyUnila Dashboard Service"
DASHBOARD_APP_ENV=production
DASHBOARD_APP_KEY=base64:your-generated-app-key-here
DASHBOARD_APP_DEBUG=false
DASHBOARD_APP_URL=http://${VM_IP}:8082

DASHBOARD_DB_CONNECTION=sqlsrv
DASHBOARD_DB_HOST=${DB_MSSQL_HOST}
DASHBOARD_DB_PORT=${DB_MSSQL_PORT}
DASHBOARD_DB_DATABASE=${DB_MSSQL_DATABASE}
DASHBOARD_DB_USERNAME=${DB_MSSQL_USERNAME}
DASHBOARD_DB_PASSWORD=${DB_MSSQL_PASSWORD}

DASHBOARD_REDIS_HOST=${REDIS_HOST}
DASHBOARD_REDIS_PORT=${REDIS_PORT}

# ========================================
# Sister Service (Go + Fiber)
# ========================================
SISTER_APP_NAME="Sister Service"
SISTER_APP_PORT=:8083
SISTER_APP_ENV=production

SISTER_DB_DRIVER=sqlserver
SISTER_DB_HOST=${DB_MSSQL_HOST}
SISTER_DB_PORT=${DB_MSSQL_PORT}
SISTER_DB_USERNAME=${DB_MSSQL_USERNAME}
SISTER_DB_PASSWORD=${DB_MSSQL_PASSWORD}
SISTER_DB_DATABASE=${DB_MSSQL_DATABASE}
SISTER_DB_MAX_OPEN_CONNS=25
SISTER_DB_MAX_IDLE_CONNS=5
SISTER_DB_CONN_MAX_LIFETIME=5m

