# ===========================================
# Auth Service Configuration - PRODUCTION
# ===========================================

APP_NAME="Auth Service"
APP_ENV=production
APP_KEY=base64:YOUR-GENERATE-NEW-APP-KEY-HERE
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://192.168.123.172:9800/auth-service

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ===========================================
# Database Configuration (SQL Server)
# ===========================================
DB_CONNECTION=sqlsrv
DB_HOST=192.168.123.119
DB_PORT=1433
DB_DATABASE=pdut_dev
DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD
DB_TRUST_SERVER_CERTIFICATE=true

# ===========================================
# Redis Configuration
# ===========================================
REDIS_CLIENT=phpredis
REDIS_HOST=192.168.123.172
REDIS_PASSWORD=
REDIS_PORT=6379

# Cache & Session
CACHE_DRIVER=redis
CACHE_PREFIX=auth_
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=CHANGE-THIS-TO-RANDOM-32-PLUS-CHARACTER-STRING
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800
JWT_ALGORITHM=HS256

# ===========================================
# SSO Configuration (Optional)
# ===========================================
SSO_ENABLED=false
SSO_PROVIDER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=

# ===========================================
# Logging
# ===========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# ===========================================
# Mail Configuration
# ===========================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="noreply@unila.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# ===========================================
# File Storage
# ===========================================
FILESYSTEM_DISK=local
