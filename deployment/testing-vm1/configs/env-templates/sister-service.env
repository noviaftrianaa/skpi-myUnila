# ===========================================
# Sister Service Configuration - PRODUCTION
# ===========================================

# Application
APP_NAME=Sister Service
APP_PORT=:8083
APP_ENV=production

# JWT Configuration (MUST match auth-service JWT_SECRET)
JWT_SECRET=CHANGE-THIS-TO-MATCH-AUTH-SERVICE-JWT-SECRET
JWT_ALGO=HS256

# API Config Encryption Key (MUST be exactly 32 characters for AES-256)
# Generate with: openssl rand -base64 32 | head -c 32
API_CONFIG_ENCRYPTION_KEY=12345678901234567890123456789012

# Sister API Kemdikbud (fallback when database config not set)
SISTER_API_BASE_URL=https://sister-api.kemdiksaintek.go.id/ws.php
SISTER_API_IDPENGGUNA=125e6431-7727-402e-adb5-24d410af493c
SISTER_API_USERNAME=YOUR_SISTER_API_USERNAME
SISTER_API_PASSWORD=YOUR_SISTER_API_PASSWORD

# Feeder PDDIKTI API (fallback when database config not set)
FEEDER_API_USERNAME=YOUR_FEEDER_USERNAME
FEEDER_API_PASSWORD=YOUR_FEEDER_PASSWORD

# SQL Server Database
DB_DRIVER=sqlserver
DB_HOST=192.168.123.119
DB_PORT=1433
DB_USER=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=pdut

# Connection Pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis Configuration
REDIS_HOST=192.168.123.172
REDIS_PORT=6379
REDIS_PASSWORD=

# Logging
LOG_LEVEL=info
