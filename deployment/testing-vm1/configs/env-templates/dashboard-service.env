# ===========================================
# Dashboard Service Configuration - PRODUCTION
# ===========================================

APP_NAME="Dashboard Service"
APP_ENV=production
APP_KEY=base64:Ni67WITr6h932ci73ilQeQkIEp6Qcu6LImnAAYyh4VI=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://192.168.123.172:9800/dashboard-service
APP_APLIKASI_ID=7ef49699-f5e8-5fa3-c4c2-f8c6189b4943

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ===========================================
# Database Configuration (SQL Server)
# ===========================================
DB_CONNECTION=sqlsrv
DB_HOST=192.168.123.119
DB_PORT=1433
DB_DATABASE=pdut
DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD
DB_TRUST_SERVER_CERTIFICATE=true

# Sister Database Connection (for SISTER data)
SISTER_DB_HOST=192.168.123.119
SISTER_DB_PORT=1433
SISTER_DB_DATABASE=pdut
SISTER_DB_USERNAME=YOUR_DB_USERNAME
SISTER_DB_PASSWORD=YOUR_DB_PASSWORD

# ===========================================
# Redis Configuration
# ===========================================
REDIS_CLIENT=phpredis
REDIS_HOST=192.168.123.172
REDIS_PASSWORD=
REDIS_PORT=6379

# Cache & Session
CACHE_DRIVER=redis
CACHE_PREFIX=dashboard_
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# ===========================================
# Dashboard Service Specific Configuration
# ===========================================
# Institution ID (Universitas Lampung)
UNILA_ID_SP=E2B705A7-173E-464A-9FAC-509128709515

# ===========================================
# Logging
# ===========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# ===========================================
# Mail Configuration
# ===========================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="noreply@unila.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# ===========================================
# File Storage
# ===========================================
FILESYSTEM_DISK=local

# ===========================================
# Production Settings
# ===========================================
AUTO_MIGRATE=false
WAIT_FOR_DB=true
