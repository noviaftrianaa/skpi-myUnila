# ============================================================================
# VM UBUNTU 2 - ENVIRONMENT CONFIGURATION
# Backend Services (Auth, Dashboard, Sister) + Redis
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION (Windows Server 2 - SQL Server 2022)
# ----------------------------------------------------------------------------
# SQL Server connection details
DB_HOST=192.168.1.13
DB_PORT=1433
DB_DATABASE=pdut_dev
DB_USERNAME=your_sql_username_here
DB_PASSWORD=your_sql_password_here

# ----------------------------------------------------------------------------
# REDIS CONFIGURATION
# ----------------------------------------------------------------------------
# Redis password (leave empty for no password if in trusted network)
# Generate with: openssl rand -base64 16
REDIS_PASSWORD=

# NOTE: For internal network deployments, you can leave REDIS_PASSWORD empty
# For production with external access, set a strong password

# ----------------------------------------------------------------------------
# LARAVEL AUTH SERVICE CONFIGURATION
# ----------------------------------------------------------------------------
# Laravel application key (base64 encoded)
# Generate with: php artisan key:generate --show
# Example: base64:abcdef1234567890ABCDEF1234567890abcdef1234567890AB==
LARAVEL_AUTH_APP_KEY=base64:your_auth_app_key_here

# Application URL
APP_URL=http://192.168.1.11:8081

# ----------------------------------------------------------------------------
# LARAVEL DASHBOARD SERVICE CONFIGURATION
# ----------------------------------------------------------------------------
# Laravel application key (base64 encoded) - MUST be different from Auth Service
# Generate with: php artisan key:generate --show
# Example: base64:1234567890abcdefABCDEF1234567890abcdef1234567890AB==
LARAVEL_DASHBOARD_APP_KEY=base64:your_dashboard_app_key_here

# ----------------------------------------------------------------------------
# JWT CONFIGURATION (for Auth Service)
# ----------------------------------------------------------------------------
# JWT Secret for token signing
# Generate with: openssl rand -base64 64
# Example: xK8mP3vR9wL2jH4nQ7tY6uE5dA1sZ0bNcM6qT8vX2lP5rJ9hG3fD7sA4wE1yU0oI==
JWT_SECRET=your_jwt_secret_here

# JWT Time to Live (in minutes)
JWT_TTL=60

# ----------------------------------------------------------------------------
# SISTER API CONFIGURATION (Go Service)
# ----------------------------------------------------------------------------
# SISTER API Base URL (Kemendikbud)
SISTER_API_BASE_URL=https://sister-api.kemdikbud.go.id/ws.php

# SISTER API Credentials (obtain from SISTER portal)
# ID Pengguna (UUID format)
# Example: 12345678-1234-1234-1234-123456789012
SISTER_API_IDPENGGUNA=your_sister_id_pengguna_here

# SISTER API Username (encrypted via Sister Service)
# Will be encrypted using API_CONFIG_ENCRYPTION_KEY
SISTER_API_USERNAME=your_sister_username_here

# SISTER API Password (encrypted via Sister Service)
# Will be encrypted using API_CONFIG_ENCRYPTION_KEY
SISTER_API_PASSWORD=your_sister_password_here

# ----------------------------------------------------------------------------
# API CONFIG ENCRYPTION KEY
# ----------------------------------------------------------------------------
# CRITICAL: Must be EXACTLY 32 characters for AES-256-GCM encryption
# Generate with: openssl rand -base64 32 | cut -c1-32
# Example: abcdef1234567890abcdef1234567890
#
# This key is used to encrypt/decrypt SISTER API credentials
API_CONFIG_ENCRYPTION_KEY=your_32_character_encryption_key

# ----------------------------------------------------------------------------
# CORS CONFIGURATION
# ----------------------------------------------------------------------------
# Allowed origins for CORS (comma-separated)
CORS_ALLOWED_ORIGINS=https://myunila.ac.id,https://api.myunila.ac.id

# ----------------------------------------------------------------------------
# INSTRUCTIONS FOR GENERATING SECRETS
# ----------------------------------------------------------------------------

# 1. Generate Kong PostgreSQL Password (for VM Ubuntu 1):
#    openssl rand -base64 32

# 2. Generate Laravel APP_KEY for Auth Service:
#    docker run --rm laravel:11 php artisan key:generate --show
#    OR if Laravel is already running:
#    docker exec auth-service php artisan key:generate --show

# 3. Generate Laravel APP_KEY for Dashboard Service:
#    docker run --rm laravel:11 php artisan key:generate --show
#    OR if Laravel is already running:
#    docker exec dashboard-service php artisan key:generate --show

# 4. Generate JWT Secret (64 bytes, base64 encoded):
#    openssl rand -base64 64
#    Example output: xK8mP3vR9wL2jH4nQ7tY6uE5dA1sZ0bNcM6qT8vX2lP5rJ9hG3fD7sA4wE1yU0oI==

# 5. Generate API Config Encryption Key (EXACTLY 32 characters):
#    openssl rand -base64 32 | cut -c1-32
#    OR manually create a 32-character string:
#    Example: abcdef1234567890ABCDEF1234567890
#
#    IMPORTANT: This MUST be exactly 32 characters (256 bits) for AES-256-GCM
#    Too short or too long will cause encryption to fail!

# 6. Generate Redis Password (optional, for production):
#    openssl rand -base64 16
#    Example: pL9kM6nR3tY2wQ5v

# 7. For SISTER API Credentials:
#    - Login to SISTER portal (https://sister.kemdikbud.go.id)
#    - Go to API Configuration section
#    - Copy your ID Pengguna (UUID format)
#    - Get your encrypted username and password
#    - OR encrypt them using the Sister Service API after deployment

# ----------------------------------------------------------------------------
# DEPLOYMENT STEPS
# ----------------------------------------------------------------------------

# Step 1: Copy this file
#    cp .env.example .env

# Step 2: Generate all secrets (see INSTRUCTIONS above)

# Step 3: Edit .env file with your actual values
#    nano .env

# Step 4: Verify database connectivity
#    Test connection to Windows Server 2 (192.168.1.13:1433)
#    telnet 192.168.1.13 1433

# Step 5: Deploy services
#    docker-compose up -d

# Step 6: Run database migrations
#    docker exec auth-service php artisan migrate --force
#    docker exec dashboard-service php artisan migrate --force

# Step 7: Verify services are running
#    docker-compose ps
#    curl http://localhost:8081/health
#    curl http://localhost:8082/health
#    curl http://localhost:8083/health

# ----------------------------------------------------------------------------
# NETWORK CONFIGURATION
# ----------------------------------------------------------------------------
# All services are connected via backend-network (bridge)
#
# External ports exposed:
#   - 8081:    Auth Service (via Nginx)
#   - 8082:    Dashboard Service (via Nginx)
#   - 8083:    Sister Service (Go - direct)
#   - 6379:    Redis
#   - 8080:    Nginx (internal proxy)
#   - 9100:    Node Exporter (Prometheus)
#   - 9113:    Nginx Exporter (Prometheus)
#   - 9121:    Redis Exporter (Prometheus)
#
# Internal services (not exposed externally):
#   - Laravel services communicate via internal network
#   - Redis accessible only within Docker network

# ----------------------------------------------------------------------------
# SECURITY NOTES
# ----------------------------------------------------------------------------
# 1. Never commit .env file to git
# 2. Use strong passwords (minimum 32 characters for critical secrets)
# 3. Rotate JWT_SECRET regularly (every 90 days recommended)
# 4. Keep API_CONFIG_ENCRYPTION_KEY secure - losing this means losing access to encrypted credentials
# 5. Restrict database access to specific IP (192.168.1.11)
# 6. Use firewall rules to limit access to backend services
# 7. Enable SSL/TLS for all external communications
# 8. Regularly update dependencies and Docker images
# 9. Monitor logs for suspicious activities
# 10. Backup encryption keys securely (offline storage recommended)

# ----------------------------------------------------------------------------
# FIREWALL RULES (UFW)
# ----------------------------------------------------------------------------
# Run these commands on VM Ubuntu 2:
#
# sudo ufw default deny incoming
# sudo ufw default allow outgoing
# sudo ufw allow 22/tcp                                    # SSH
# sudo ufw allow from 192.168.1.10 to any port 8081       # Auth Service from VM1
# sudo ufw allow from 192.168.1.10 to any port 8082       # Dashboard Service from VM1
# sudo ufw allow from 192.168.1.10 to any port 8083       # Sister Service from VM1
# sudo ufw allow from 192.168.1.10 to any port 6379       # Redis from VM1
# sudo ufw allow from 192.168.1.12 to any port 9100       # Node Exporter from Windows Server 1
# sudo ufw allow from 192.168.1.12 to any port 9113       # Nginx Exporter from Windows Server 1
# sudo ufw allow from 192.168.1.12 to any port 9121       # Redis Exporter from Windows Server 1
# sudo ufw allow out to 192.168.1.13 port 1433            # SQL Server outbound
# sudo ufw enable

# ----------------------------------------------------------------------------
# BACKUP LOCATIONS
# ----------------------------------------------------------------------------
# Docker volumes to backup:
#   - redis_data (Redis persistence)
#
# Configuration files to backup:
#   - .env (CRITICAL - contains all secrets)
#   - ./nginx/nginx.conf
#   - ./nginx/conf.d/*.conf
#   - docker-compose.yml
#
# Database backups:
#   - Handled by SQL Server on Windows Server 2
#   - Verify backup schedule with DBA
#
# Recommended backup schedule:
#   - Configuration files: Daily
#   - Redis data: Hourly (via Redis RDB snapshots)
#   - Database: As per DBA schedule (typically daily + transaction logs)

# ----------------------------------------------------------------------------
# TROUBLESHOOTING
# ----------------------------------------------------------------------------
#
# Issue: Container won't start
# Solution: Check logs with: docker-compose logs <service-name>
#
# Issue: Database connection failed
# Solution:
#   - Verify DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD
#   - Test connectivity: telnet 192.168.1.13 1433
#   - Check SQL Server allows remote connections
#   - Verify firewall rules on Windows Server 2
#
# Issue: JWT tokens not working
# Solution:
#   - Verify JWT_SECRET is set and base64 encoded
#   - Check JWT_TTL value (in minutes)
#   - Ensure Auth Service is running
#
# Issue: SISTER API sync fails
# Solution:
#   - Verify SISTER_API_IDPENGGUNA format (must be UUID)
#   - Check SISTER_API_USERNAME and SISTER_API_PASSWORD are encrypted
#   - Verify API_CONFIG_ENCRYPTION_KEY is exactly 32 characters
#   - Test SISTER API connectivity manually
#
# Issue: Redis connection refused
# Solution:
#   - Check Redis container is running: docker ps | grep redis
#   - Verify REDIS_PASSWORD matches in all services
#   - Test Redis: docker exec redis redis-cli ping
#
# Issue: Services can't communicate
# Solution:
#   - Verify all services are on same backend-network
#   - Check Docker network: docker network inspect backend-network
#   - Restart Docker daemon if needed

# ----------------------------------------------------------------------------
# MAINTENANCE TASKS
# ----------------------------------------------------------------------------
#
# Weekly:
#   - Check container health: docker-compose ps
#   - Review logs for errors: docker-compose logs --tail=100
#   - Monitor disk usage: df -h
#   - Check Redis memory usage: docker exec redis redis-cli info memory
#
# Monthly:
#   - Update Docker images: docker-compose pull && docker-compose up -d
#   - Rotate logs if not using log rotation
#   - Review and update firewall rules
#   - Test backup restoration procedure
#
# Quarterly:
#   - Rotate JWT_SECRET and redeploy Auth Service
#   - Review and update dependencies
#   - Security audit of configurations
#   - Performance testing and optimization

# ----------------------------------------------------------------------------
# MONITORING INTEGRATION
# ----------------------------------------------------------------------------
# All services expose metrics for Prometheus scraping:
#   - Node Exporter (9100): Host metrics (CPU, memory, disk, network)
#   - Redis Exporter (9121): Redis metrics (memory, keys, commands)
#   - Nginx Exporter (9113): Nginx metrics (requests, connections)
#
# Prometheus server on Windows Server 1 (192.168.1.12:9090) scrapes these endpoints
# Grafana dashboards on Windows Server 1 (192.168.1.12:3002) visualize the metrics
#
# Recommended alerts to configure:
#   - High CPU usage (>80% for 5 minutes)
#   - High memory usage (>90% for 5 minutes)
#   - Service down (any container stopped)
#   - Disk space low (<15% free)
#   - High error rate in logs (5xx errors >5%)
#   - Database connection pool exhausted
#   - Redis memory usage high (>75%)

# ----------------------------------------------------------------------------
# VERSION INFORMATION
# ----------------------------------------------------------------------------
# Docker Compose Version: 3.8
# Laravel Version: 11.x
# PHP Version: 8.3
# Go Version: 1.22
# Redis Version: 7.x
# Nginx Version: Alpine (latest stable)
# SQL Server: 2022 (on Windows Server 2)

