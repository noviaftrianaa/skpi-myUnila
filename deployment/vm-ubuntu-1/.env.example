# ============================================================================
# VM UBUNTU 1 - ENVIRONMENT CONFIGURATION
# Frontend + Kong Gateway + Nginx
# ============================================================================

# ----------------------------------------------------------------------------
# Kong Database Configuration
# ----------------------------------------------------------------------------
# PostgreSQL password for Kong database
# Generate with: openssl rand -base64 32
KONG_PG_PASSWORD=your_strong_kong_password_here

# ----------------------------------------------------------------------------
# Backend Services Location
# ----------------------------------------------------------------------------
# IP address of VM Ubuntu 2 (where backend services are running)
VM_UBUNTU_2_IP=192.168.1.11

# ----------------------------------------------------------------------------
# Frontend Configuration
# ----------------------------------------------------------------------------
# Main application URL (production domain)
NEXT_PUBLIC_APP_URL=https://myunila.ac.id

# API Gateway URL (Kong proxy)
NEXT_PUBLIC_API_URL=https://api.myunila.ac.id

# Sister Service API URL (via Kong)
NEXT_PUBLIC_SISTER_API_URL=https://api.myunila.ac.id/api/sister

# ----------------------------------------------------------------------------
# Monitoring Endpoints
# ----------------------------------------------------------------------------
# Prometheus server (Windows Server 1)
PROMETHEUS_URL=http://192.168.1.12:9090

# Grafana server (Windows Server 1)
GRAFANA_URL=http://192.168.1.12:3000

# ----------------------------------------------------------------------------
# INSTRUCTIONS
# ----------------------------------------------------------------------------

# 1. Copy this file to .env:
#    cp .env.example .env

# 2. Generate Kong database password:
#    openssl rand -base64 32

# 3. Update VM_UBUNTU_2_IP with actual IP address

# 4. Update domain names (myunila.ac.id) with your actual domain

# 5. Ensure SSL certificates are ready:
#    - /etc/letsencrypt/live/myunila.ac.id/fullchain.pem
#    - /etc/letsencrypt/live/myunila.ac.id/privkey.pem

# 6. For development/testing (before SSL):
#    NEXT_PUBLIC_APP_URL=http://localhost:3000
#    NEXT_PUBLIC_API_URL=http://localhost:9800

# ----------------------------------------------------------------------------
# NETWORK CONFIGURATION
# ----------------------------------------------------------------------------
# All services are connected via kong-network (bridge)
# External ports exposed:
#   - 80:    HTTP (Nginx)
#   - 443:   HTTPS (Nginx)
#   - 9800:  Kong HTTP Proxy
#   - 9843:  Kong HTTPS Proxy
#   - 8001:  Kong Admin API (internal only)
#   - 9100:  Node Exporter (Prometheus)
#   - 9113:  Nginx Exporter (Prometheus)

# ----------------------------------------------------------------------------
# SECURITY NOTES
# ----------------------------------------------------------------------------
# - Never commit .env file to git
# - Use strong passwords (min 32 characters)
# - Restrict Kong Admin API to internal network only
# - Enable firewall rules (ufw)
# - Keep SSL certificates updated (certbot renew)

# ----------------------------------------------------------------------------
# BACKUP LOCATIONS
# ----------------------------------------------------------------------------
# Docker volumes to backup:
#   - kong_postgres_data (Kong database)

# Configuration files to backup:
#   - ./nginx/nginx.conf
#   - ./nginx/conf.d/*.conf
#   - /etc/letsencrypt/ (SSL certificates)
