# ============================================================================
# VM UBUNTU 3 - ENVIRONMENT CONFIGURATION
# Sync Services: Sister Service + PDDIKTI Feeder
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE (Windows Server 2)
# ----------------------------------------------------------------------------
DB_HOST=192.168.1.13
DB_PORT=1433
DB_DATABASE=pdut_dev
DB_USERNAME=your_sql_server_username
DB_PASSWORD=your_strong_sql_server_password

# ----------------------------------------------------------------------------
# REDIS CONFIGURATION
# ----------------------------------------------------------------------------
# Redis password (optional but recommended)
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=your_strong_redis_password

# ----------------------------------------------------------------------------
# SISTER SERVICE CONFIGURATION
# ----------------------------------------------------------------------------
# SISTER API Base URL (WITHOUT /1.0 suffix)
SISTER_API_BASE_URL=https://sister-api.kemdikbud.go.id/ws.php

# SISTER API Credentials (dari database setting.api_configs)
SISTER_API_IDPENGGUNA=your_id_pengguna_uuid
SISTER_API_USERNAME=your_encrypted_username
SISTER_API_PASSWORD=your_encrypted_password

# API Config Encryption Key (exactly 32 characters for AES-256-GCM)
# Generate with: openssl rand -base64 32 | cut -c1-32
API_CONFIG_ENCRYPTION_KEY=12345678901234567890123456789012

# Sister Sync Schedule (Cron format)
# Default: Daily at 2 AM for Dosen, 3 AM for Mahasiswa
SYNC_SCHEDULE_DOSEN=0 2 * * *
SYNC_SCHEDULE_MAHASISWA=0 3 * * *
SYNC_SCHEDULE_MATAKULIAH=0 4 * * *

# Sync Batch Size (number of records per batch)
SYNC_BATCH_SIZE=100

# Max Retries for failed sync
SYNC_MAX_RETRIES=3

# ----------------------------------------------------------------------------
# PDDIKTI FEEDER SERVICE CONFIGURATION
# ----------------------------------------------------------------------------
# PDDIKTI Neo Feeder API
FEEDER_API_BASE_URL=https://pddikti.kemdikbud.go.id/api-neo-feeder
FEEDER_API_USERNAME=your_feeder_username
FEEDER_API_PASSWORD=your_feeder_password

# Kode PT (dari PDDIKTI)
FEEDER_KODE_PT=041022

# Upload Schedule (Cron format)
# Default: Weekly on Sunday at 4 AM
UPLOAD_SCHEDULE=0 4 * * 0

# Upload Batch Size
UPLOAD_BATCH_SIZE=50

# Max Retries for failed upload
UPLOAD_MAX_RETRIES=3

# Enable upload validation before sending
UPLOAD_VALIDATION=true

# ----------------------------------------------------------------------------
# MONITORING ENDPOINTS
# ----------------------------------------------------------------------------
# Prometheus server (Windows Server 1)
PROMETHEUS_URL=http://192.168.1.12:9090

# Grafana server (Windows Server 1)
GRAFANA_URL=http://192.168.1.12:3000

# ----------------------------------------------------------------------------
# INSTRUCTIONS
# ----------------------------------------------------------------------------

# 1. Copy this file to .env:
#    cp .env.example .env

# 2. Generate API Config Encryption Key (EXACTLY 32 characters):
#    openssl rand -base64 32 | cut -c1-32

# 3. Generate Redis Password:
#    openssl rand -base64 32

# 4. Update database credentials (from Windows Server 2)

# 5. Get SISTER API credentials from database:
#    SELECT * FROM setting.api_configs WHERE api_code = 'SISTER'

# 6. Get PDDIKTI Feeder credentials from PDDIKTI admin

# 7. Verify schedule format (use https://crontab.guru):
#    0 2 * * *  = Every day at 2:00 AM
#    0 4 * * 0  = Every Sunday at 4:00 AM

# ----------------------------------------------------------------------------
# NETWORK CONFIGURATION
# ----------------------------------------------------------------------------
# All services are connected via sync-network (bridge)
# External ports exposed:
#   - 8083:  Sister Service
#   - 8084:  PDDIKTI Feeder Service
#   - 6379:  Redis (Sync Queue)
#   - 8080:  Nginx (optional reverse proxy)
#   - 9100:  Node Exporter (Prometheus)
#   - 9121:  Redis Exporter (Prometheus)
#   - 9113:  Nginx Exporter (Prometheus)

# ----------------------------------------------------------------------------
# SECURITY NOTES
# ----------------------------------------------------------------------------
# - Never commit .env file to git
# - Use strong passwords (min 32 characters)
# - Restrict access to VM Ubuntu 3 (firewall rules)
# - Enable firewall:
#     sudo ufw allow from 192.168.1.10  # VM Ubuntu 1 (Kong)
#     sudo ufw allow from 192.168.1.12  # Windows Server 1 (Prometheus)
#     sudo ufw allow 22/tcp              # SSH (admin only)
#     sudo ufw enable

# - SISTER API credentials are already encrypted in database
# - API_CONFIG_ENCRYPTION_KEY must match the key used to encrypt credentials
# - Keep sync logs for audit trail (minimum 90 days)

# ----------------------------------------------------------------------------
# SYNC SCHEDULE RECOMMENDATIONS
# ----------------------------------------------------------------------------
# Sister Service:
#   - Dosen: Daily at 2 AM (low activity period)
#   - Mahasiswa: Daily at 3 AM
#   - Mata Kuliah: Daily at 4 AM
#
# PDDIKTI Feeder:
#   - Weekly upload on Sunday at 4 AM
#   - Or after each semester registration period
#
# Avoid scheduling during:
#   - Business hours (8 AM - 5 PM)
#   - Peak usage (10 AM - 2 PM)
#   - Backup windows (check with DBA)

# ----------------------------------------------------------------------------
# PERFORMANCE TUNING
# ----------------------------------------------------------------------------
# For large datasets (> 10,000 records):
#   - Increase SYNC_BATCH_SIZE to 200-500
#   - Increase Docker memory limits in docker-compose.yml
#   - Consider running sync during weekends only
#
# For small datasets (< 1,000 records):
#   - Decrease SYNC_BATCH_SIZE to 50
#   - Can run sync more frequently (every 6 hours)

# ----------------------------------------------------------------------------
# TROUBLESHOOTING
# ----------------------------------------------------------------------------
# Check sync logs:
#   docker-compose logs -f sister-service
#   docker-compose logs -f feeder-service
#
# Check Redis queue:
#   docker exec -it redis-sync redis-cli
#   AUTH your_redis_password
#   KEYS sync:*
#   LLEN sync:queue:dosen
#
# Manual trigger sync:
#   curl -X POST http://localhost:8083/admin/sync/dosen
#   curl -X POST http://localhost:8083/admin/sync/mahasiswa
#
# Check sync status:
#   curl http://localhost:8083/admin/sync/status
#   curl http://localhost:8084/admin/upload/status

# ----------------------------------------------------------------------------
# BACKUP LOCATIONS
# ----------------------------------------------------------------------------
# Docker volumes to backup:
#   - redis_sync_data (Redis sync queue & cache)
#
# Database tables to backup (Windows Server 2):
#   - sister.sync_logs
#   - sister.sync_history
#   - pddikti.upload_logs
#   - pddikti.upload_history
#
# Backup schedule:
#   - Daily: Docker volumes
#   - Weekly: Full database backup
#   - Before major sync: Manual backup

# ----------------------------------------------------------------------------
# MONITORING & ALERTS
# ----------------------------------------------------------------------------
# Grafana dashboards to setup:
#   - Sister Sync Status Dashboard
#   - PDDIKTI Upload Status Dashboard
#   - Redis Queue Monitoring
#   - Service Health & Uptime
#
# Alerts to configure:
#   - Sync failed for > 3 consecutive attempts
#   - Upload failed for > 2 consecutive attempts
#   - Redis queue size > 10,000 items
#   - Service down for > 5 minutes
#   - Database connection failed

# ----------------------------------------------------------------------------
# MAINTENANCE SCHEDULE
# ----------------------------------------------------------------------------
# Daily:
#   - Review sync logs for errors
#   - Monitor Redis queue size
#
# Weekly:
#   - Verify PDDIKTI upload success
#   - Check disk space usage
#   - Review sync performance metrics
#
# Monthly:
#   - Cleanup old sync logs (> 90 days)
#   - Review and optimize batch sizes
#   - Update service dependencies
#
# Per Semester:
#   - Verify all data synced correctly
#   - Reconcile data with SISTER & PDDIKTI
#   - Update sync schedules if needed
