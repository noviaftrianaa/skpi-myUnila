# Public API base URL (Kong gateway atau direct nginx vm9)
NEXT_PUBLIC_BLOG_API=http://localhost:8091

# Meilisearch (search-only public key)
NEXT_PUBLIC_MEILI_HOST=http://localhost:7700
NEXT_PUBLIC_MEILI_SEARCH_KEY=__public_search_only_key__

# Use mock data sampai backend ready
NEXT_PUBLIC_USE_MOCK=true

# Apex hostname (untuk middleware routing detection)
NEXT_PUBLIC_APEX_HOST=blog.unila.ac.id

# Webhook secret untuk on-demand revalidation
REVALIDATE_SECRET=__random_64char_secret__
