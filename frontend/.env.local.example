# ========================================
# MyUnila Frontend - Local Environment
# ========================================
# Copy file ini ke .env.local untuk development dengan `npm run dev`
#   cp .env.local.example .env.local
#
# Mode TANPA Kong (default untuk tim):
#   Frontend langsung akses backend service via port masing-masing
#
# Mode DENGAN Kong:
#   Ganti semua URL ke http://localhost:9800/... (lihat contoh di bawah)
# ========================================

# === Mode Tanpa Kong (Default) ===
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8081/api/v1
NEXT_PUBLIC_PUBLIC_API_URL=http://localhost:8082/api/v1
NEXT_PUBLIC_SISTER_API_URL=http://localhost:8083
NEXT_PUBLIC_FEEDER_API_URL=http://localhost:8084
NEXT_PUBLIC_MYUNILA_API_URL=http://localhost:8086
NEXT_PUBLIC_KEUANGAN_API_URL=http://localhost:8088
NEXT_PUBLIC_DASHBOARD_API_URL=http://localhost:8087/api/v1

# === Mode Dengan Kong (uncomment jika pakai Kong) ===
# NEXT_PUBLIC_API_URL=http://localhost:9800
# NEXT_PUBLIC_AUTH_API_URL=http://localhost:9800/auth-service/api/v1
# NEXT_PUBLIC_PUBLIC_API_URL=http://localhost:9800/public-service/api/v1
# NEXT_PUBLIC_SISTER_API_URL=http://localhost:9800/sister-service
# NEXT_PUBLIC_FEEDER_API_URL=http://localhost:9800/feeder-service
# NEXT_PUBLIC_MYUNILA_API_URL=http://localhost:9800/myunila-service
# NEXT_PUBLIC_KEUANGAN_API_URL=http://localhost:9800/keuangan-service
# NEXT_PUBLIC_DASHBOARD_API_URL=http://localhost:9800/dashboard-service/api/v1
