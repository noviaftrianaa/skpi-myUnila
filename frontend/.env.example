# Application Configuration
NEXT_PUBLIC_APP_NAME=My Unila Portal
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Configuration
# Kong API Gateway - access backend services via Kong
NEXT_PUBLIC_AUTH_API_URL=http://localhost:9800/auth-service/api/v1
NEXT_PUBLIC_PUBLIC_API_URL=http://localhost:9800/public-service/api/v1

# Sister Service (Kemdikbud Integration) - Via Kong Gateway
# Note: Photo endpoint (/dosen/photo) is public (no auth required)
NEXT_PUBLIC_SISTER_API_URL=http://localhost:9800/sister-service

# Feeder Service (PDDikti Integration) - Via Kong Gateway
NEXT_PUBLIC_FEEDER_API_URL=http://localhost:9800/feeder-service

# API Timeout
NEXT_PUBLIC_API_TIMEOUT=30000

# Environment
NODE_ENV=development

# Optional: External Services
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NEXT_PUBLIC_SENTRY_DSN=
