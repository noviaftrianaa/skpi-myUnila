# Application Configuration
NEXT_PUBLIC_APP_NAME=My Unila Portal
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Configuration
# Kong API Gateway - access backend services via Kong
NEXT_PUBLIC_AUTH_API_URL=http://localhost:9800/auth-service/api/v1
NEXT_PUBLIC_DASHBOARD_API_URL=http://localhost:9800/dashboard-service/public/api/v1

# Sister Service (Kemdikbud Integration) - Direct to service (not via Kong)
# Note: Sister service has its own public endpoints at port 8083
NEXT_PUBLIC_SISTER_API_URL=http://localhost:9800/sister-service/public

# API Timeout
NEXT_PUBLIC_API_TIMEOUT=30000

# Environment
NODE_ENV=development

# Optional: External Services
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NEXT_PUBLIC_SENTRY_DSN=
